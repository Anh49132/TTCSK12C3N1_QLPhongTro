@model QL_PhongTro.ViewModels.ChiSoDienNuocViewModel
@using System.Globalization
@{ ViewData["Title"] = "Chốt chỉ số điện nước"; }
<section aria-labelledby="meter-title">
    <h1 id="meter-title" class="h3">Chốt chỉ số điện nước</h1>
    <p>Kỳ hiện tại: <strong>@Model.DauKy.ToString("MM/yyyy")</strong></p>
    @if(TempData["MeterSuccess"] is {} success){<div class="alert alert-success">@success</div>}
    @if (Model.ToaNhas.Count == 0)
    {
        <div class="alert alert-info">Bạn chưa được phân công tòa nhà đang hoạt động.</div>
    }
    else
    {
        <form method="get" asp-controller="ChiSoDienNuoc" asp-action="Index" class="mb-4">
            <label for="toaNhaId" class="form-label">Tòa nhà</label>
            <div class="d-flex gap-2 flex-wrap">
                <select id="toaNhaId" name="toaNhaId" class="form-select w-auto">
                    @foreach (var building in Model.ToaNhas)
                    {
                        <option value="@building.Id" selected="@(building.Id == Model.ToaNhaId)">@building.Ten</option>
                    }
                </select>
                <button type="submit" class="btn btn-primary">Xem danh sách</button>
            </div>
        </form>
        @if (Model.TongPhongCanChot == 0)
        {
            <p data-meter-progress>Không có phòng cần ghi chỉ số trong kỳ này.</p>
        }
        else
        {
            <p data-meter-progress>Đã chốt: @Model.SoPhongDaChot/@Model.TongPhongCanChot · Còn lại: @Model.SoPhongConLai phòng</p>
        }
        @if (Model.Phongs.Count == 0)
        {
            <div class="alert alert-info">Không có phòng đang thuê có hợp đồng hiệu lực trong kỳ này.</div>
        }
        @foreach (var floor in Model.Phongs.GroupBy(x => x.Tang))
        {
            <h2 class="h5">Tầng @floor.Key</h2>
            <div class="table-responsive mb-4">
                <table class="table table-striped align-middle">
                    <caption class="visually-hidden">Chỉ số tham chiếu các phòng tầng @floor.Key</caption>
                    <thead><tr><th scope="col">Mã phòng</th><th scope="col">Tầng</th><th scope="col">Điện kỳ trước</th><th scope="col">Nước kỳ trước</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead>
                    <tbody>
                    @foreach (var room in floor)
                    {
                        <tr><th scope="row">@room.MaPhong</th><td>@room.Tang</td>
                            @foreach (var reading in new[] { room.Dien, room.Nuoc })
                            {
                                <td>@if (reading.GiaTri is { } value)
                                    { <span>@value.ToString("0.###", CultureInfo.GetCultureInfo("vi-VN"))</span>
                                      @if (reading.LaBanGiao) { <small class="d-block text-muted">Chỉ số bàn giao</small> } }
                                    else { <span class="text-muted">Chưa có dữ liệu</span> }</td>
                            }
                            <td>@(room.DaChot ? "Đã chốt" : "Chưa chốt")</td>
                            <td>
                            @if(room.DichVu.Count==0){<span class="text-muted">Không có dịch vụ theo chỉ số cần nhập.</span>}
                            else {
                                <form asp-action="Save" method="post" class="meter-form" data-meter-form>
                                    <input type="hidden" name="ToaNhaId" value="@Model.ToaNhaId" />
                                    <input type="hidden" name="PhongId" value="@room.PhongId" />
                                    <input type="hidden" name="HopDongId" value="@room.HopDongId" />
                                    <input type="hidden" name="Ky" value="@Model.DauKy.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="PhienBanPhong" value="@(Model.Input?.PhongId==room.PhongId?Model.Input.PhienBanPhong:room.PhienBanPhong)" />
                                    @foreach(var service in room.DichVu){
                                        var field=service.Ma=="DIEN"?"DienMoi":"NuocMoi";
                                        var label=service.Ma=="DIEN"?"Điện":"Nước";
                                        var id=$"meter-{room.PhongId}-{service.Ma}";
                                        var submitted=Model.Input?.PhongId==room.PhongId;
                                        var value=submitted?(service.Ma=="DIEN"?Model.Input!.DienMoi:Model.Input!.NuocMoi):service.Moi;
                                        var error=submitted && Model.Loi.TryGetValue(field,out var messages)?string.Join(" ",messages):"";
                                        if (service.Truoc.GiaTri == null && error.Length == 0) error = "Chưa có dữ liệu tham chiếu. Không thể chốt chỉ số.";
                                        var version=submitted?(service.Ma=="DIEN"?Model.Input!.DienPhienBan:Model.Input!.NuocPhienBan):service.PhienBan;
                                        <input type="hidden" name="@(service.Ma=="DIEN"?"DienPhienBan":"NuocPhienBan")" value="@version" />
                                        <label for="@id" class="form-label">@label mới</label>
                                        <input id="@id" name="@field" type="number" step="0.001" min="0" max="99999999999.999" required
                                               value="@value?.ToString(CultureInfo.InvariantCulture)" class="form-control @(error.Length>0?"is-invalid":"")"
                                               data-previous="@service.Truoc.GiaTri?.ToString(CultureInfo.InvariantCulture)" data-meter-input
                                               aria-describedby="@(id+"-error")" aria-invalid="@(error.Length>0?"true":"false")" readonly="@(service.DaKhoa)" />
                                        <span id="@(id+"-error")" class="text-danger d-block" data-meter-error>@error</span>
                                    }
                                    @if(Model.Input?.PhongId==room.PhongId && Model.Loi.TryGetValue("Phong",out var roomErrors)){<p class="text-danger">@string.Join(" ",roomErrors)</p>}
                                    @if (Model.Input?.PhongId == room.PhongId && Model.Input.CanhBaos.Count > 0)
                                    {
                                        <div class="alert alert-warning" role="alert" data-usage-warning>
                                            <strong>Mức tiêu thụ bất thường — phòng @room.MaPhong</strong>
                                            @foreach (var warning in Model.Input.CanhBaos)
                                            {
                                                <p>
                                                    <strong>@(warning.Ma == "DIEN" ? "Điện" : "Nước"):</strong>
                                                    Chỉ số trước @warning.ChiSoTruoc.ToString("0.###", CultureInfo.GetCultureInfo("vi-VN")),
                                                    chỉ số mới @warning.ChiSoMoi.ToString("0.###", CultureInfo.GetCultureInfo("vi-VN")).
                                                    Tiêu thụ kỳ này @warning.TieuThu.ToString("0.###", CultureInfo.GetCultureInfo("vi-VN"));
                                                    kỳ lịch sử gần nhất @warning.TieuThuKyTruoc.ToString("0.###", CultureInfo.GetCultureInfo("vi-VN"));
                                                    trung bình 3 kỳ @warning.TrungBinh.ToString("0.######", CultureInfo.GetCultureInfo("vi-VN"));
                                                    ngưỡng 200% @warning.Nguong.ToString("0.######", CultureInfo.GetCultureInfo("vi-VN")).
                                                    @if (warning.TrungBinh == 0) { <span>Ba kỳ lịch sử không có tiêu thụ; kỳ này có tiêu thụ dương.</span> }
                                                </p>
                                            }
                                            <p>Chưa lưu chỉ số. Bạn có thể sửa ô nhập rồi bấm Lưu phòng để kiểm tra lại, hoặc xác nhận các số hiện tại.</p>
                                            <input type="hidden" name="MaXacNhan" value="@Model.Input.MaXacNhan" />
                                            <button type="submit" class="btn btn-warning" name="XacNhanBatThuong" value="true">Xác nhận vẫn muốn lưu</button>
                                        </div>
                                    }
                                    <button class="btn btn-primary mt-2" type="submit" disabled="@(room.DichVu.Any(x=>x.Truoc.GiaTri==null || x.DaKhoa))">Lưu phòng @room.MaPhong</button>
                                </form>
                            }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    }
</section>
@section Scripts {<script src="~/js/meter-readings.js" asp-append-version="true"></script>}
