@model QL_PhongTro.ViewModels.ChiSoDienNuocViewModel
@using System.Globalization
@{ ViewData["Title"] = "Chốt chỉ số điện nước"; }
<section aria-labelledby="meter-title">
    <h1 id="meter-title" class="h3">Chốt chỉ số điện nước</h1>
    <p>Kỳ hiện tại: <strong>@Model.DauKy.ToString("MM/yyyy")</strong></p>
    @if (Model.ToaNhas.Count == 0)
    {
        <div class="alert alert-info">Bạn chưa được phân công tòa nhà đang hoạt động.</div>
    }
    else
    {
        <form method="get" asp-controller="ChiSoDienNuoc" asp-action="Index" class="mb-4">
            <label for="toaNhaId" class="form-label">Tòa nhà</label>
            <div class="d-flex gap-2 flex-wrap">
                <select id="toaNhaId" name="toaNhaId" class="form-select w-auto">
                    @foreach (var building in Model.ToaNhas)
                    {
                        <option value="@building.Id" selected="@(building.Id == Model.ToaNhaId)">@building.Ten</option>
                    }
                </select>
                <button type="submit" class="btn btn-primary">Xem danh sách</button>
            </div>
        </form>
        @if (Model.Phongs.Count == 0)
        {
            <div class="alert alert-info">Không có phòng đang thuê có hợp đồng hiệu lực trong kỳ này.</div>
        }
        @foreach (var floor in Model.Phongs.GroupBy(x => x.Tang))
        {
            <h2 class="h5">Tầng @floor.Key</h2>
            <div class="table-responsive mb-4">
                <table class="table table-striped align-middle">
                    <caption class="visually-hidden">Chỉ số tham chiếu các phòng tầng @floor.Key</caption>
                    <thead><tr><th scope="col">Mã phòng</th><th scope="col">Tầng</th><th scope="col">Điện kỳ trước</th><th scope="col">Nước kỳ trước</th><th scope="col">Trạng thái</th></tr></thead>
                    <tbody>
                    @foreach (var room in floor)
                    {
                        <tr><th scope="row">@room.MaPhong</th><td>@room.Tang</td>
                            @foreach (var reading in new[] { room.Dien, room.Nuoc })
                            {
                                <td>@if (reading.GiaTri is { } value)
                                    { <span>@value.ToString("0.###", CultureInfo.GetCultureInfo("vi-VN"))</span>
                                      @if (reading.LaBanGiao) { <small class="d-block text-muted">Chỉ số bàn giao</small> } }
                                    else { <span class="text-muted">Chưa có dữ liệu</span> }</td>
                            }
                            <td>@(room.DaChot ? "Đã chốt" : "Chưa chốt")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    }
</section>
