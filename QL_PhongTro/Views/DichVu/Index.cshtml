@model QL_PhongTro.ViewModels.DanhSachDichVuViewModel
@using QL_PhongTro.Models
@using System.Globalization
@using QL_PhongTro.Services
@{ var error = TempData.Peek("Error") as string; }
@inject QL_PhongTro.Authorization.PermissionService Permissions
@{ ViewData["Title"] = "Dịch vụ và đơn giá"; var write = await Permissions.AllowsAsync("PHONG_TRO", true); }
<section class="mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div><p class="text-uppercase text-secondary small">Vận hành nhà cho thuê</p><h1 class="h2">Dịch vụ và đơn giá</h1><p class="text-secondary mb-0">Danh sách dịch vụ đã khai báo theo từng tòa nhà.</p></div>
    @if (Model.SanSang && Model.ToaNhaId.HasValue && await Permissions.AllowsAsync("PHONG_TRO", true))
    { <a asp-action="Create" asp-route-toaNhaId="@Model.ToaNhaId" class="btn btn-primary">Thêm dịch vụ</a> }
</section>
@if (!Model.SanSang)
{
    <div class="alert alert-info" role="status">Chức năng dịch vụ chưa sẵn sàng. Vui lòng liên hệ người quản trị để hoàn tất thiết lập.</div>
}
else if (Model.ToaNhas.Count == 0)
{
    <p>Bạn chưa có tòa nhà đang hoạt động.</p>
    <a asp-controller="PhongTro" asp-action="TaoToaNha" class="btn btn-primary">Khai báo tòa nhà</a>
}
else
{
    @if (write && Model.ToaNhaId.HasValue)
    {
        <p><a asp-action="DienNuoc" asp-route-toaNhaId="@Model.ToaNhaId" class="btn btn-outline-primary">Cấu hình điện nước</a></p>
    }
    @if (await Permissions.AllowsAsync("TAI_CHINH")) { <p><a class="btn btn-outline-primary" asp-controller="HoaDonDichVu" asp-action="Index" asp-route-toaNhaId="@Model.ToaNhaId">Lập và xem hóa đơn</a></p> }
    @if (Model.CanKhoiTao && await Permissions.AllowsAsync("PHONG_TRO", true))
    {
        <form id="initialize-services" asp-action="Initialize" method="post" class="mb-3">
            <input name="toaNhaId" value="@Model.ToaNhaId" type="hidden" />
            <p>Chuẩn bị điện, nước, rác, gửi xe và internet cho tòa nhà.</p><button class="btn btn-primary">Khởi tạo năm dịch vụ</button>
        </form>
        @if (error is null) { <script>document.getElementById('initialize-services').requestSubmit();</script> }
    }
    <form method="get" class="d-flex flex-wrap align-items-end gap-2 mb-4">
        <div><label for="toaNhaId" class="form-label">Tòa nhà</label><select id="toaNhaId" name="toaNhaId" asp-for="ToaNhaId" asp-items="Model.ToaNhas" class="form-select"></select></div>
        <button class="btn btn-outline-primary" type="submit">Xem dịch vụ</button>
    </form>
    @if (Model.DichVus.Count == 0)
    { <p class="text-secondary">Chưa có dịch vụ. Chọn “Thêm dịch vụ” để khai báo đơn giá đầu tiên.</p> }
    else
    {
        <p class="text-secondary">Mặc định chỉ áp dụng khi tạo phòng mới. Các phòng đã tồn tại giữ nguyên lựa chọn.</p>
        <div class="table-responsive">
        <table class="table align-middle">
            <caption>@Model.DichVus.Select(x => x.DichVuId).Distinct().Count() dịch vụ đã khai báo</caption>
            <thead><tr><th scope="col">STT</th><th scope="col">Tên dịch vụ</th><th scope="col">Cách tính tiền</th><th scope="col">Đơn vị tính</th><th scope="col" class="text-end">Đơn giá (VND)</th><th scope="col">Trạng thái</th><th scope="col">Áp dụng mặc định</th>@if (write) { <th scope="col">Thao tác</th> }</tr></thead>
            <tbody>@{ var serviceStt = 0; } @foreach (var versions in Model.DichVus.GroupBy(x => x.DichVuId))
            {
                serviceStt++;
                var item = versions.Where(x => x.TuNgay <= DichVuService.HomNay()).OrderBy(x => x.TuNgay).LastOrDefault() ?? versions.OrderBy(x => x.TuNgay).First();
                var serviceStatusClass = !item.DaChotGia ? "text-bg-warning" : item.DangApDung && item.DichVu.DangHoatDong ? "text-bg-success" : "text-bg-danger";
                <tr><td>@serviceStt</td><td><a asp-action="Manage" asp-route-toaNhaId="@Model.ToaNhaId" asp-route-dichVuId="@item.DichVuId">@item.DichVu.TenDichVu</a>@if (DichVuMacDinhOptions.LaMacDinh(item.DichVu.MaDichVu)) { <span class="badge text-bg-light ms-1">Danh mục gợi ý</span> }@if (versions.Any(x => x.TuNgay > DichVuService.HomNay())) { <small class="d-block text-secondary">Có thay đổi đã lên lịch</small> }</td><td>@CachTinhDichVu.Ten(item.CachTinh)</td><td>@item.DonViTinh</td><td class="text-end text-nowrap">@(item.DaChotGia ? item.DonGia.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) : "Chưa thiết lập")</td><td><span class="badge @serviceStatusClass">@(!item.DaChotGia ? "Chờ đơn giá" : item.DangApDung && item.DichVu.DangHoatDong ? "Đang áp dụng" : "Ngừng áp dụng")</span></td>
                <td>
                    @if (write)
                    {
                        <form asp-action="SetDefault" method="post">
                            <input type="hidden" name="toaNhaId" value="@Model.ToaNhaId" />
                            <input type="hidden" name="dichVuId" value="@item.DichVuId" />
                            <input type="hidden" name="enabled" value="@((!Model.MacDinhIds.Contains(item.DichVuId)).ToString().ToLowerInvariant())" />
                            <button class="btn btn-sm btn-outline-secondary" aria-label="Đổi mặc định @item.DichVu.TenDichVu">@(Model.MacDinhIds.Contains(item.DichVuId) ? "Có — bỏ mặc định" : "Không — đặt mặc định")</button>
                        </form>
                    }
                    else { @(Model.MacDinhIds.Contains(item.DichVuId) ? "Có" : "Không") }
                </td>
                @if (write)
                {
                    <td><div class="d-flex flex-wrap gap-2">
                        <a asp-action="Manage" asp-route-toaNhaId="@Model.ToaNhaId" asp-route-dichVuId="@item.DichVuId" class="btn btn-sm btn-outline-primary" aria-label="Sửa đơn giá @item.DichVu.TenDichVu">Sửa đơn giá</a>
                        <form asp-action="Delete" method="post" data-service-name="@item.DichVu.TenDichVu" onsubmit="return confirm('Xóa dịch vụ ' + this.dataset.serviceName + ' khỏi tòa nhà? Dịch vụ đã được sử dụng sẽ không thể xóa.');">
                            <input name="toaNhaId" value="@Model.ToaNhaId" type="hidden" />
                            <input name="dichVuId" value="@item.DichVuId" type="hidden" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Xóa @item.DichVu.TenDichVu">Xóa</button>
                        </form>
                    </div></td>
                }
                </tr>
            }</tbody>
        </table>
        </div>
    }
}
