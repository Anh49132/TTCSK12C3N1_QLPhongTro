@model QL_PhongTro.ViewModels.ChiTietToaNhaViewModel
@using System.Globalization
@inject QL_PhongTro.Authorization.PermissionService Permissions
@{
    ViewData["Title"] = "Chi tiết tòa nhà";
    var b = Model.ToaNha; var vn = CultureInfo.GetCultureInfo("vi-VN");
    var write = await Permissions.AllowsAsync("PHONG_TRO", true) && (User.IsInRole("CHU_NHA") || User.IsInRole("ADMIN"));
    var occupancy = Model.TongPhong == 0 ? 0 : 100m * Model.DangThue / Model.TongPhong;
    var finance = await Permissions.AllowsAsync("TAI_CHINH");
}
<div class="building-detail">
<nav class="bd-breadcrumb"><a asp-action="ToaNha">Tòa nhà</a><span>›</span><strong>Chi tiết tòa nhà</strong></nav>
<header class="bd-heading"><div><a asp-action="ToaNha" class="bd-back">← Danh sách tòa nhà</a><div class="bd-title"><h1>@b.TenToaNha</h1><span class="bd-status">@(b.DangHoatDong ? "Đang vận hành" : "Ngừng hoạt động")</span></div></div>
@if (write) { <div class="bd-actions"><a asp-action="SuaToaNha" asp-route-id="@b.Id" class="bd-button">✎ Chỉnh sửa tòa nhà</a>@if (b.DangHoatDong) { <a asp-action="Create" asp-route-toaNhaId="@b.Id" class="bd-button bd-primary">＋ Thêm phòng</a> }</div> }
</header>
<section class="bd-overview"><img src="@(Model.Anh ?? Url.Content("~/room-placeholder.svg"))" alt="Ảnh phòng trong @b.TenToaNha" />
<div class="bd-overview-main"><p class="bd-address">⌖ @string.Join(", ", new[] { b.DiaChi, b.PhuongXa, b.QuanHuyen, b.TinhThanh }.Where(x => !string.IsNullOrWhiteSpace(x)))</p>
<div class="bd-facts"><div><small>Mã tòa nhà</small><strong>TN-@b.Id.ToString("D3")</strong></div><div><small>Quy mô</small><strong>@(b.SoTang?.ToString() ?? "—") tầng · @Model.TongPhong phòng</strong></div><div><small>Diện tích phòng</small><strong>@(Model.DienTichMin?.ToString("0.#", vn) ?? "—")–@(Model.DienTichMax?.ToString("0.#", vn) ?? "—") m²</strong></div></div>
@if (!string.IsNullOrWhiteSpace(b.GhiChu)) { <p class="bd-muted">@b.GhiChu</p> }</div>
<div class="bd-management"><small>Người quản lý</small><strong>@(Model.QuanLy ?? "Chưa phân công")</strong><div class="bd-facts"><div><small>Kỳ hóa đơn</small><strong>Hàng tháng</strong></div><div><small>Ngày chốt</small><strong>Ngày @b.NgayChotHangThang.ToString("D2")</strong></div></div></div>
</section>
<section class="bd-stats"><article><small>Phòng đang thuê <span>▣</span></small><strong>@Model.DangThue / @Model.TongPhong <em>phòng</em></strong><p>@occupancy.ToString("0.#", vn)% công suất thuê</p><progress value="@Model.DangThue" max="@Math.Max(1, Model.TongPhong)"></progress></article>
<article><small>Phòng trống <span>▤</span></small><strong>@Model.Trong.ToString("D2") <em>phòng</em></strong><p>Sẵn sàng cho thuê</p><progress value="@Model.Trong" max="@Math.Max(1, Model.TongPhong)"></progress></article>
@if (finance) { <article><small>Đã thu tháng này <span>▧</span></small><strong>— <em>đ</em></strong><p>Chưa có dữ liệu thu tiền</p></article><article><small>Còn phải thu <span>▧</span></small><strong>— <em>đ</em></strong><p>Chưa có dữ liệu thanh toán</p></article> }
else { <article><small>Đã đặt cọc <span>▧</span></small><strong>@Model.DatCoc <em>phòng</em></strong><p>Phòng đang được giữ chỗ</p></article> }
</section>
<div class="bd-attention"><span>ⓘ Cần chú ý</span><strong>@Model.Trong phòng trống · @Model.DatCoc phòng đã đặt cọc</strong><a asp-controller="YeuCau" asp-action="Index">Xem yêu cầu thuê →</a></div>
<section class="bd-room-panel"><div class="bd-panel-heading"><h2>Danh sách phòng <small>@Model.TongPhong phòng</small></h2><div class="bd-actions">
@if (write && b.DangHoatDong) { <a asp-controller="DichVu" asp-action="DienNuoc" asp-route-toaNhaId="@b.Id" class="bd-button">Cấu hình điện nước</a> }
<a asp-action="Index" asp-route-toaNhaId="@b.Id" class="bd-button">Quản lý phòng ↗</a></div></div>
<div class="bd-tabs"><a class="@(string.IsNullOrEmpty(Model.TrangThai) ? "active" : "")" asp-route-id="@b.Id">Tất cả phòng <small>@Model.TongPhong</small></a><a class="@(Model.TrangThai == "DANG_THUE" ? "active" : "")" asp-route-id="@b.Id" asp-route-trangThai="DANG_THUE">Đang thuê <small>@Model.DangThue</small></a><a class="@(Model.TrangThai == "TRONG" ? "active" : "")" asp-route-id="@b.Id" asp-route-trangThai="TRONG">Còn trống <small>@Model.Trong</small></a></div>
<form method="get" class="bd-filters" asp-action="ChiTietToaNha" asp-route-id="@b.Id"><input name="tuKhoa" value="@Model.TuKhoa" placeholder="Tìm mã phòng..." aria-label="Tìm mã phòng" /><select name="tang" aria-label="Tầng"><option value="">Tất cả tầng</option>@foreach (var floor in Model.Tangs) { <option value="@floor" selected="@(Model.Tang == floor)">Tầng @floor</option> }</select><select name="trangThai" aria-label="Trạng thái"><option value="">Tất cả trạng thái</option>@foreach (var state in Enum.GetValues<QL_PhongTro.ViewModels.TrangThaiPhong>()) { <option value="@state" selected="@(Model.TrangThai == state.ToString())">@QL_PhongTro.Controllers.PhongTroController.StatusLabel(state)</option> }</select><button class="bd-button" type="submit">Lọc phòng</button><span class="bd-muted">↕ Theo tầng, mã phòng</span></form>
<div class="bd-table-scroll"><table class="bd-table"><thead><tr><th>Phòng</th><th>Khách thuê</th><th>Trạng thái</th><th>Giá thuê</th><th>Hợp đồng</th><th></th></tr></thead><tbody>
@foreach (var row in Model.Phongs) { var p = row.Phong; <tr><td><strong>@p.MaPhong</strong><small>Tầng @p.Tang · @(p.LoaiPhong ?? "Phòng trọ") · @p.DienTich.ToString("0.#", vn) m²</small></td><td>@(row.Khach ?? (p.TrangThai == "TRONG" ? "Chưa có khách thuê" : "Chưa ghi nhận"))</td><td><span class="bd-room-status @(p.TrangThai == "DANG_THUE" ? "rented" : p.TrangThai == "TRONG" ? "vacant" : "reserved")">@QL_PhongTro.Controllers.PhongTroController.StatusLabel(Enum.TryParse<QL_PhongTro.ViewModels.TrangThaiPhong>(p.TrangThai, out var roomState) ? roomState : QL_PhongTro.ViewModels.TrangThaiPhong.NGUNG_CHO_THUE)</span></td><td><strong>@p.GiaThue.ToString("N0", vn) đ</strong><small>/ tháng</small></td><td>@if (row.HopDongId.HasValue) { @if (User.IsInRole("CHU_NHA") && await Permissions.AllowsAsync("HOP_DONG")) { <a asp-controller="HopDong" asp-action="Details" asp-route-id="@row.HopDongId">@row.MaHopDong</a> } else { @row.MaHopDong }<small>Đến @row.HanHopDong?.ToString("dd/MM/yyyy")</small> } else { <span class="bd-muted">—</span> }</td><td>@if (write) { <a asp-action="Edit" asp-route-id="@p.Id" aria-label="Sửa phòng @p.MaPhong">Chỉnh sửa</a> }</td></tr> }
@if (Model.Phongs.Count == 0) { <tr><td colspan="6" class="bd-empty">Không có phòng phù hợp với bộ lọc.</td></tr> }
</tbody></table></div>
<footer class="bd-pagination"><span>Hiển thị @Model.Phongs.Count trong @Model.TongKetQua phòng phù hợp</span><nav aria-label="Phân trang phòng">@for (var i = Math.Max(1, Model.Trang - 2); i <= Math.Min(Model.TongTrang, Model.Trang + 2); i++) { <a class="@(i == Model.Trang ? "active" : "")" asp-route-id="@b.Id" asp-route-trang="@i" asp-route-tuKhoa="@Model.TuKhoa" asp-route-tang="@Model.Tang" asp-route-trangThai="@Model.TrangThai">@i</a> }</nav></footer>
</section></div>
@section Styles { <link rel="stylesheet" href="~/css/building-detail.css" asp-append-version="true" /> }
