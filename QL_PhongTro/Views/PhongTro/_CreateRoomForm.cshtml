@model QL_PhongTro.ViewModels.TaoPhongViewModel
@{ var locations = ViewData["RoomBuildingLocations"] as Dictionary<string, string>; var floors = ViewData["RoomBuildingFloors"] as Dictionary<string, int?>; }
<div class="room-create-page"><header class="rc-heading"><div><h1>Thêm phòng mới</h1><p>Thiết lập thông tin, giá thuê và tiện nghi để bắt đầu quản lý phòng.</p></div><span>* Trường thông tin bắt buộc</span></header>
<form asp-action="Create" method="post" novalidate><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="rc-layout"><div class="rc-main">
<section class="rc-card rc-basic-card"><div class="rc-card-heading"><span class="rc-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3h8v18H8zM11 3v18m2-9h1" /></svg></span><div><h2>Thông tin cơ bản</h2><p>Xác định phòng và cơ sở quản lý.</p></div></div><div class="rc-fields">
<div><label asp-for="ToaNhaId">Cơ sở <em>*</em></label><select asp-for="ToaNhaId" data-room-building><option value="">Chọn cơ sở</option>@foreach (var building in Model.ToaNhaOptions) { <option value="@building.Value" data-location="@(locations?.GetValueOrDefault(building.Value!))" data-floors="@(floors?.GetValueOrDefault(building.Value!))">@building.Text</option> }</select><small data-room-location>@(locations?.GetValueOrDefault(Model.ToaNhaId?.ToString() ?? ""))</small><span asp-validation-for="ToaNhaId" class="text-danger"></span></div>
<div><label asp-for="MaPhong">Số / tên phòng <em>*</em></label><input asp-for="MaPhong" autocomplete="off" /><small>Tên phòng phải là duy nhất trong cùng cơ sở.</small><span asp-validation-for="MaPhong" class="text-danger"></span></div>
<div class="rc-wide rc-three"><div><label asp-for="Tang">Tầng</label><input asp-for="Tang" type="number" list="rc-floor-options" /><datalist id="rc-floor-options"></datalist><span asp-validation-for="Tang" class="text-danger"></span></div><div><label asp-for="DienTich">Diện tích <em>*</em></label><div class="rc-unit"><input asp-for="DienTich" type="number" min="0.01" step="0.01" /><span>m²</span></div><span asp-validation-for="DienTich" class="text-danger"></span></div><div><label asp-for="SoNguoiToiDa">Sức chứa tối đa <em>*</em></label><div class="rc-unit"><input asp-for="SoNguoiToiDa" type="number" min="1" /><span>người</span></div><span asp-validation-for="SoNguoiToiDa" class="text-danger"></span></div></div>
<fieldset class="rc-wide rc-status"><legend>Trạng thái ban đầu</legend><div class="rc-status-options"><label class="rc-status-option"><input asp-for="TrangThai" type="radio" id="TrangThaiTrong" value="TRONG" checked="@(Model.TrangThai is null || Model.TrangThai == QL_PhongTro.ViewModels.TrangThaiPhong.TRONG)" /><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3h8v18H8zM11 3v18m2-9h1" /></svg><span>Còn trống</span></label><label class="rc-status-option rc-status-unavailable" title="Chưa hỗ trợ chức năng bảo trì"><input type="radio" id="TrangThaiBaoTri" disabled aria-label="Bảo trì — chưa hỗ trợ" /><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 6a5 5 0 0 0-6 6l-5 5a2 2 0 0 0 3 3l5-5a5 5 0 0 0 6-6l-3 3-3-3z" /></svg><span>Bảo trì</span></label></div><span asp-validation-for="TrangThai" class="text-danger"></span><small>Trạng thái “Đang thuê” được cập nhật khi bạn tạo hợp đồng cho phòng.</small><small class="rc-unavailable-note">Bảo trì: chưa có chức năng, tạm thời không hoạt động.</small></fieldset></div></section>
<section class="rc-card rc-pricing-card">
    <div class="rc-card-heading"><span class="rc-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h14v14H4zM4 8h16v8h-7V8m3 4h1" /></svg></span><div><h2>Giá thuê &amp; tiền cọc</h2><p>Các khoản tiền được tính bằng Việt Nam đồng (đ).</p></div></div>
    <div class="rc-fields">
        <div><label asp-for="GiaThueDisplay">Giá thuê hàng tháng <em>*</em></label><div class="rc-unit"><input asp-for="GiaThueDisplay" inputmode="numeric" autocomplete="off" data-vnd-input placeholder="4.800.000" /><span>đ / tháng</span></div><span asp-validation-for="GiaThue" class="text-danger"></span></div>
        <div><label for="rc-deposit-preview">Tiền cọc <em>*</em></label><div class="rc-unit"><input id="rc-deposit-preview" placeholder="4.800.000" disabled aria-describedby="rc-pricing-unavailable" /><span>đ</span></div></div>
    </div>
    <p class="rc-hint">ⓘ Tiền cọc tương đương 1 tháng thuê. Có thể điều chỉnh theo hợp đồng.</p>
    <div class="rc-services">
        <div class="rc-services-heading"><h2>Phí dịch vụ</h2><button type="button" disabled>＋ Thêm phí khác</button></div>
        <p>Chọn các dịch vụ áp dụng cho phòng và điều chỉnh đơn giá.</p>
        <div class="rc-service-table" role="group" aria-label="Khung cấu hình phí dịch vụ chưa hoạt động">
            <div class="rc-service-table-head"><span>Dịch vụ áp dụng</span><span>Đơn giá</span><span>Cách tính</span></div>
            @foreach (var service in new[] { (Name: "Điện", Icon: "ϟ", Price: "3.500", Unit: "kWh"), (Name: "Nước", Icon: "♧", Price: "20.000", Unit: "m³"), (Name: "Internet", Icon: "⌁", Price: "100.000", Unit: "phòng / tháng"), (Name: "Vệ sinh", Icon: "♲", Price: "30.000", Unit: "người / tháng") })
            {
                <div class="rc-service-row"><label><input type="checkbox" checked disabled /><span class="rc-service-icon" aria-hidden="true">@service.Icon</span><span>@service.Name</span></label><div class="rc-unit"><input placeholder="@service.Price" disabled aria-label="Đơn giá @service.Name — minh họa" /><span>đ</span></div><select disabled aria-label="Cách tính @service.Name"><option>@service.Unit</option></select></div>
            }
        </div>
        <p class="rc-service-help">Điện, nước tính theo chỉ số công tơ; các phí còn lại thu cùng tiền thuê hàng tháng.</p>
        <p id="rc-pricing-unavailable" class="rc-service-unavailable">Khung minh họa: tiền cọc, chọn dịch vụ, đơn giá, cách tính và thêm phí khác chưa hoạt động tại đây. Các mức giá mẫu không được lưu. Phòng mới vẫn nhận dịch vụ mặc định của cơ sở; sau khi lưu có thể cấu hình dịch vụ theo luồng hiện có.</p>
    </div>
</section>

</div><aside class="rc-aside"><section class="rc-card"><div class="rc-card-heading"><span class="rc-icon">▣</span><div><h2>Tiện nghi</h2><p>Thông tin tiện nghi của phòng.</p></div></div><p class="rc-note">Chưa hỗ trợ khai báo tiện nghi riêng cho phòng.</p></section><section class="rc-card"><div class="rc-card-heading"><span class="rc-icon">▧</span><div><h2>Ảnh phòng</h2><p>Thêm ảnh để thể hiện rõ nét phòng.</p></div></div><div class="rc-upload-info"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17V7m-4 4 4-4 4 4M6 17H4a4 4 0 0 1 0-8 6 6 0 0 1 12-1 4 4 0 0 1 4 8h-2"/></svg><strong>Thêm ảnh sau khi lưu phòng</strong><small>JPG, PNG · Tối đa 5 MB / ảnh · 8 ảnh</small></div><p class="rc-note">Mở chỉnh sửa phòng để tải ảnh và chọn ảnh đại diện.</p></section><section class="rc-card rc-room-notes"><div class="rc-card-heading"><span class="rc-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 5H5v15h15v-8M10 14l1-4 7-7 3 3-7 7-4 1zM17 4l3 3" /></svg></span><div><h2>Ghi chú</h2><p>Thông tin bổ sung dành cho việc quản lý.</p></div></div><textarea id="rc-room-notes-preview" maxlength="500" rows="4" disabled aria-label="Ghi chú — chưa hỗ trợ lưu" aria-describedby="rc-room-notes-status" placeholder="Phòng có cửa sổ, đón ánh sáng tự nhiên. Đã sơn mới và vệ sinh điều hòa. Phù hợp cho 1–2 người."></textarea><div class="rc-room-notes-footer"><span>Chỉ hiển thị cho chủ nhà</span><span>0 / 500 ký tự</span></div><small id="rc-room-notes-status">Chưa hỗ trợ lưu ghi chú cho phòng; tạm thời không hoạt động.</small></section></aside></div>
<footer class="rc-footer"><span>Phòng sẽ được thêm vào cơ sở bạn chọn.</span><div><a asp-action="Index" asp-route-toaNhaId="@Model.ToaNhaId">Hủy</a><button type="submit">✓ Lưu phòng</button></div></footer></form></div>
