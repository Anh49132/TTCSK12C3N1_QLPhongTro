@model QL_PhongTro.ViewModels.NhatKyPhongViewModel
@using QL_PhongTro.ViewModels
@{
    ViewData["Title"] = "Nhật ký phòng";
}
<nav class="d-flex gap-2 mb-3" aria-label="Quản lý phòng">
    <a class="btn btn-outline-secondary" asp-action="Index">Danh sách phòng</a>
</nav>
<section class="mb-4">
    <p class="text-uppercase text-secondary small fw-semibold mb-2">Lịch sử phòng</p>
    <h1 class="h2 mb-1">Nhật ký phòng @Model.MaPhong</h1>
    <p class="text-secondary mb-0">Tòa nhà: @Model.TenToaNha · Trạng thái hiện tại: @Model.TrangThaiPhong</p>
</section>
<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-sm-6 col-md-3">
        <label asp-for="TuNgay" class="form-label">Từ ngày</label>
        <input asp-for="TuNgay" type="date" class="form-control" />
    </div>
    <div class="col-sm-6 col-md-3">
        <label asp-for="DenNgay" class="form-label">Đến ngày</label>
        <input asp-for="DenNgay" type="date" class="form-control" />
    </div>
    <div class="col-auto d-flex gap-2">
        <button class="btn btn-primary" type="submit">Lọc nhật ký</button>
        <a class="btn btn-outline-secondary" asp-action="NhatKyPhong" asp-route-phongId="@Model.PhongId">Xóa bộ lọc</a>
    </div>
</form>
<p>@Model.Total hoạt động · Trang @Model.Page/@Model.Pages</p>
<div class="table-responsive"><table class="table align-top"><thead><tr><th>STT</th><th>Thời điểm</th><th>Người thực hiện</th><th>Vai trò</th><th>Thao tác</th><th>Thông tin liên quan</th><th>Nội dung thay đổi</th></tr></thead><tbody>
@{ var stt = (Model.Page - 1) * 20; }
@foreach (var row in Model.Rows)
{
    stt++;
    var display = AuditDisplay.Describe(row);
    <tr>
        <td>@stt</td>
        <td>@row.ThoiDiem.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td>
        <td>@(row.TenNguoiThucHien ?? "Chưa ghi nhận tên") @if (row.NguoiThucHienId is not null) { <small class="d-block text-muted">Mã tài khoản: @row.NguoiThucHienId</small> }</td>
        <td>@AuditDisplay.Role(row.VaiTroLucThucHien)</td>
        <td>@NhatKyViewModel.ActionName(row.HanhDong)</td>
        <td>@display.Subject</td>
        <td>
            <p class="mb-1">@display.Summary</p>
            @if (display.Changes.Count > 0)
            {
                <table class="table table-sm table-bordered mt-1 mb-0" aria-label="Chi tiết thay đổi">
                    <thead><tr><th scope="col">Thông tin</th><th scope="col">Trước</th><th scope="col">Sau</th></tr></thead>
                    <tbody>
                    @foreach (var change in display.Changes)
                    {
                        <tr><th scope="row">@change.Label</th>
                        <td style="overflow-wrap:anywhere">@change.Before</td>
                        <td style="overflow-wrap:anywhere">@change.After</td></tr>
                    }
                    </tbody>
                </table>
            }
            else if (!display.Unreadable)
            {
                <p class="text-secondary mb-0">Không có thông tin chi tiết được lưu cho thao tác này.</p>
            }
        </td>
    </tr>
}
@if (Model.Rows.Count == 0) { <tr><td colspan="7">Không có nhật ký phù hợp.</td></tr> }
</tbody></table></div>
<nav aria-label="Phân trang nhật ký phòng">
@foreach (var pageNumber in new[] { Model.Page - 1, Model.Page + 1 }.Where(p => p >= 1 && p <= Model.Pages))
{
    <a class="btn btn-outline-primary" asp-action="NhatKyPhong" asp-route-phongId="@Model.PhongId"
       asp-route-page="@pageNumber"
       asp-route-tuNgay="@Model.TuNgay?.ToString("yyyy-MM-dd")"
       asp-route-denNgay="@Model.DenNgay?.ToString("yyyy-MM-dd")">@(pageNumber < Model.Page ? "Trang trước" : "Trang sau")</a>
}
</nav>
