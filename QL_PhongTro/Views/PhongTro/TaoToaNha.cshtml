@model QL_PhongTro.ViewModels.TaoToaNhaViewModel

@{
    ViewData["Title"] = "Khai báo tòa nhà";
}

<div class="mb-4">
    <a asp-action="Index" class="link-secondary">Quản lý phòng</a>
    <h1 class="h2 mt-2">Khai báo tòa nhà</h1>
</div>

<form asp-action="TaoToaNha" method="post" class="row g-3" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-12 col-md-7">
        <label asp-for="TenToaNha" class="form-label"></label>
        <input asp-for="TenToaNha" class="form-control" />
        <span asp-validation-for="TenToaNha" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-7">
        <label asp-for="DiaChi" class="form-label"></label>
        <input asp-for="DiaChi" class="form-control" />
        <span asp-validation-for="DiaChi" class="text-danger"></span>
    </div>
    <div class="col-12 d-flex gap-2 pt-2">
        <button type="submit" class="btn btn-primary">Lưu tòa nhà</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}