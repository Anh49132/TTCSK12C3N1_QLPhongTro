@model QL_PhongTro.ViewModels.TinDangQuanLyViewModel
@{
    ViewData["Title"] = "Quản lý tin đăng";
    var ok = TempData["TinDangOk"] as string;
}

<section class="mb-4">
    <p class="text-uppercase text-secondary small fw-semibold mb-2">Cho thuê</p>
    <h1 class="h2 mb-1">Quản lý tin đăng</h1>
    <p class="text-secondary mb-0">Đăng hoặc gỡ tin của các phòng thuộc tòa nhà bạn sở hữu hoặc được phân công quản lý.</p>
</section>

@if (ok is not null) { <div class="alert alert-success" role="status">@ok</div> }
@if (Model.DanhSach.Any(item => item.DaHetHan))
{
    <div class="alert alert-warning" role="status">Có tin đã hết hạn và được tự động chuyển sang Tạm ẩn. Bạn có thể kiểm tra rồi đăng lại tin.</div>
}

@if (Model.DanhSach.Count == 0)
{
    <div class="border-top border-bottom py-4">
        <h2 class="h5">Chưa có phòng để đăng tin</h2>
        <p class="text-secondary mb-0">Hãy khai báo tòa nhà và phòng trước.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light"><tr><th>STT</th><th>Tòa nhà</th><th>Phòng</th><th>Trạng thái phòng</th><th>Tin đăng</th><th>Trạng thái tin</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
            @{ var listingStt = 0; }
            @foreach (var item in Model.DanhSach)
            {
                listingStt++;
                var dangHienThi = item.TrangThaiTin == "DANG_HIEN_THI";
                var roomBadge = item.TrangThaiPhong switch { "TRONG" => "text-bg-success", "DA_DAT_COC" => "text-bg-warning", "DANG_THUE" => "text-bg-primary", _ => "text-bg-secondary" };
                var listingBadge = item.TrangThaiTin switch { "DANG_HIEN_THI" => "text-bg-success", "TAM_AN" => "text-bg-warning", "DA_CHO_THUE" => "text-bg-primary", "NHAP" => "text-bg-secondary", _ => "text-bg-light" };
                <tr>
                    <td>@listingStt</td>
                    <td>@item.TenToaNha</td>
                    <th>@item.MaPhong</th>
                    <td><span class="badge @roomBadge">@(item.TrangThaiPhong == "TRONG" ? "Trống" : item.TrangThaiPhong)</span></td>
                    <td>@(item.TieuDe ?? "Chưa có tin")</td>
                    <td>
                        <span class="badge @listingBadge">@(item.TrangThaiTin switch { "DANG_HIEN_THI" => "Đang hiển thị", "TAM_AN" => "Tạm ẩn", "NHAP" => "Nháp", "DA_CHO_THUE" => "Đã cho thuê", _ => item.TrangThaiTin ?? "Chưa có" })</span>
                        @if (item.DaHetHan) { <span class="badge text-bg-warning d-block mt-1">Đã hết hạn</span> }
                    </td>
                    <td class="text-end">
                        <div class="d-flex justify-content-end gap-2">
                            @if (dangHienThi && item.TinDangId is { } listingId)
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-action="ChiTiet" asp-route-id="@listingId">Xem</a>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Tao" asp-route-phongId="@item.PhongId">Sửa tin</a>
                                <form method="post" asp-action="Go" asp-route-id="@listingId" onsubmit="return confirm('Gỡ tin này khỏi danh sách công khai?');">
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Gỡ tin</button>
                                </form>
                            }
                            else if (item.TrangThaiPhong == "TRONG")
                            {
                                <a class="btn btn-sm btn-primary" asp-action="Tao" asp-route-phongId="@item.PhongId">@(item.TrangThaiTin == "NHAP" ? "Chỉnh sửa" : item.TinDangId.HasValue ? "Đăng lại" : "Đăng tin")</a>
                            }
                            else
                            {
                                <span class="text-secondary small">Phòng chưa trống</span>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
