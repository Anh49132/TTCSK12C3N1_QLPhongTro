@model QL_PhongTro.ViewModels.ChiTietTinDangViewModel
@{ ViewData["Title"] = Model.Tin.TieuDe; }
<article class="card p-4 mb-4">
    <h1>@Model.Tin.TieuDe</h1>
    <p>Phòng @Model.Phong.MaPhong · @Model.Phong.DienTich m² · @Model.Phong.GiaThue.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) đ/tháng</p>
    <p style="white-space: pre-wrap">@Model.Tin.NoiDung</p>
    <a asp-action="Index">Quay lại tin đăng</a>
</article>
@if (User.IsInRole("KHACH_THUE"))
{
    <a class="btn btn-primary mb-3" href="#gui-yeu-cau">Gửi yêu cầu</a>
    <section id="gui-yeu-cau" class="card p-4" aria-labelledby="request-heading">
        <h2 id="request-heading">Gửi yêu cầu xem phòng hoặc thuê ngay</h2>
        <p>Các trường có dấu * là bắt buộc.</p>
        <form asp-action="GuiYeuCau" asp-route-id="@Model.Tin.Id" method="post">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <div class="mb-3"><label asp-for="Form.LoaiYeuCau" class="form-label">Loại yêu cầu *</label>
                <select asp-for="Form.LoaiYeuCau" class="form-select" required>
                    <option value="">Chọn loại yêu cầu</option><option value="XEM_PHONG">Xem phòng</option><option value="THUE_NGAY">Thuê ngay</option>
                </select><span asp-validation-for="Form.LoaiYeuCau" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Form.NgayMongMuon" class="form-label">Ngày mong muốn *</label>
                <input asp-for="Form.NgayMongMuon" type="date" class="form-control" required />
                <span asp-validation-for="Form.NgayMongMuon" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Form.SoNguoiDuKien" class="form-label">Số người dự kiến ở *</label>
                <input asp-for="Form.SoNguoiDuKien" type="number" min="1" step="1" class="form-control" required />
                <span asp-validation-for="Form.SoNguoiDuKien" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Form.LoiNhan" class="form-label">Lời nhắn</label>
                <textarea asp-for="Form.LoiNhan" class="form-control" rows="4" maxlength="2000"></textarea>
                <span asp-validation-for="Form.LoiNhan" class="text-danger"></span></div>
            <button class="btn btn-primary" type="submit">Gửi yêu cầu</button>
        </form>
    </section>
}
else if (User.Identity?.IsAuthenticated != true)
{
    <a class="btn btn-primary" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("ChiTiet", new { id = Model.Tin.Id })">Đăng nhập để gửi yêu cầu</a>
}
else { <p>Chức năng gửi yêu cầu dành cho tài khoản Khách thuê.</p> }
