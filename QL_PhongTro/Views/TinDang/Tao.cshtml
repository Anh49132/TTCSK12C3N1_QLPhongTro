@model QL_PhongTro.ViewModels.TaoTinDangViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Đăng tin cho thuê";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
}

<section class="mb-4">
    <p class="text-uppercase text-secondary small fw-semibold mb-2">Cho thuê</p>
    <h1 class="h2 mb-1">Đăng tin cho thuê</h1>
    <p class="text-secondary mb-0">@Model.TenToaNha · phòng @Model.MaPhong</p>
</section>

<dl class="row border-top border-bottom py-3 mb-4">
    <dt class="col-sm-3">Diện tích</dt><dd class="col-sm-9">@Model.DienTich.ToString("N2", culture) m²</dd>
    <dt class="col-sm-3">Giá thuê</dt><dd class="col-sm-9">@Model.GiaThue.ToString("N0", culture) đ / tháng</dd>
</dl>

<form method="post" asp-action="Tao" class="row g-3">
    <input asp-for="PhongId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="col-12">
        <label asp-for="TieuDe" class="form-label">Tiêu đề</label>
        <input asp-for="TieuDe" class="form-control" maxlength="200" />
        <span asp-validation-for="TieuDe" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="NoiDung" class="form-label">Mô tả thêm</label>
        <textarea asp-for="NoiDung" class="form-control" rows="7" maxlength="4000"></textarea>
        <span asp-validation-for="NoiDung" class="text-danger"></span>
    </div>
    <div class="col-12 d-flex gap-2">
        <button class="btn btn-primary" type="submit">Đăng tin</button>
        <a class="btn btn-outline-secondary" asp-action="QuanLy">Hủy</a>
    </div>
</form>
