@model IReadOnlyList<QL_PhongTro.ViewModels.TinDangDanhSachViewModel>
@{
    ViewData["Title"] = "Tin đăng cho thuê";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}
<section class="listing-index" aria-labelledby="listing-index-title">
    <p class="listing-eyebrow">PHÒNG TRỐNG ĐANG CHO THUÊ</p>
    <h1 id="listing-index-title">Tin đăng cho thuê</h1>
    <form asp-controller="TimTin" asp-action="Index" method="get" class="border rounded p-3 mb-4" aria-label="Tìm và lọc tin đăng">
        <div class="row g-3">
            <div class="col-12">
                <label for="listing-keyword" class="form-label">Tiêu đề hoặc thông tin phòng</label>
                <input id="listing-keyword" name="TuKhoa" class="form-control" maxlength="200" placeholder="Tiêu đề, mô tả, mã phòng hoặc địa chỉ" />
            </div>
            <div class="col-sm-6"><label for="listing-district" class="form-label">Quận/huyện</label><input id="listing-district" name="QuanHuyen" class="form-control" placeholder="Ví dụ: Quận 1" /></div>
            <div class="col-sm-6"><label for="listing-ward" class="form-label">Phường/xã</label><input id="listing-ward" name="PhuongXa" class="form-control" placeholder="Ví dụ: Phường Bến Nghé" /></div>
            <div class="col-sm-6 col-lg-3"><label for="listing-min-price" class="form-label">Giá từ</label><input id="listing-min-price" name="GiaToiThieu" type="number" min="0" step="1" class="form-control" /></div>
            <div class="col-sm-6 col-lg-3"><label for="listing-max-price" class="form-label">Giá đến</label><input id="listing-max-price" name="GiaToiDa" type="number" min="0" step="1" class="form-control" /></div>
            <div class="col-sm-6 col-lg-3"><label for="listing-min-area" class="form-label">Diện tích từ (m²)</label><input id="listing-min-area" name="DienTichToiThieu" type="number" min="0" step="0.01" class="form-control" /></div>
            <div class="col-sm-6 col-lg-3"><label for="listing-max-area" class="form-label">Diện tích đến (m²)</label><input id="listing-max-area" name="DienTichToiDa" type="number" min="0" step="0.01" class="form-control" /></div>
            <div class="col-sm-6 col-lg-3"><label for="listing-capacity" class="form-label">Số người ở</label><input id="listing-capacity" name="SoNguoiToiDa" type="number" min="1" step="1" class="form-control" /></div>
        </div>
        <button type="submit" class="btn btn-primary mt-3">Tìm và lọc</button>
    </form>
    @if (Model.Count == 0)
    {
        <p class="listing-muted">Hiện chưa có tin đăng đang hiển thị.</p>
    }
    else
    {
        <div class="listing-index-grid">
            @foreach (var tin in Model)
            {
                <article class="listing-index-item">
                    <a asp-action="ChiTiet" asp-route-id="@tin.Id" class="listing-index-image">
                        <img src="@(tin.AnhDaiDien ?? Url.Content("~/room-placeholder.svg"))" alt="Ảnh đại diện: @tin.TieuDe" loading="lazy" />
                    </a>
                    <h2><a asp-action="ChiTiet" asp-route-id="@tin.Id">@tin.TieuDe</a></h2>
                </article>
            }
        </div>
    }
</section>
