@model IReadOnlyList<QL_PhongTro.Models.TinDang>
@{ ViewData["Title"] = "Tin đăng cho thuê"; }
<h1>Tin đăng cho thuê</h1>
@if (Model.Count == 0) { <p>Hiện chưa có tin đăng đang hiển thị.</p> }
@foreach (var tin in Model)
{
    <article class="card p-3 mb-3"><h2 class="h5"><a asp-action="ChiTiet" asp-route-id="@tin.Id">@tin.TieuDe</a></h2></article>
}
