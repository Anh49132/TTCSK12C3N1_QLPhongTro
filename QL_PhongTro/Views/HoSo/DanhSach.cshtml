@model List<QL_PhongTro.Models.KhachThue>
@{ ViewData["Title"] = "Hồ sơ khách thuê"; }
<h1>Hồ sơ khách thuê</h1>
<p class="text-muted">Khách thuê đã có hợp đồng với các tòa nhà của bạn. Bạn chỉ có quyền xem hồ sơ.</p>
@if (Model.Count == 0)
{
    <p>Chưa có hồ sơ khách thuê đã có hợp đồng với bạn.</p>
}
else
{
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>STT</th><th>Họ tên</th><th>Số điện thoại</th><th>Thao tác</th></tr></thead>
            <tbody>
            @{ var profileStt = 0; }
            @foreach (var profile in Model)
            {
                profileStt++;
                <tr><td>@profileStt</td><td>@profile.HoTen</td><td>@profile.SoDienThoai</td><td><a asp-action="Xem" asp-route-id="@profile.Id">Xem hồ sơ</a></td></tr>
            }
            </tbody>
        </table>
    </div>
}
