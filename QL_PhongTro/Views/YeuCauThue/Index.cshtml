@model QL_PhongTro.ViewModels.YeuCauThueIndexViewModel
@using QL_PhongTro.Models
@using QL_PhongTro.Services
@{
    ViewData["Title"] = "Yêu cầu thuê";
}
<p class="eyebrow">@if (Model.LaChuNha) { <text>CHỦ NHÀ</text> } else { <text>KHÁCH THUÊ</text> }</p>
<h1>Yêu cầu thuê</h1>
<p>
    Thời gian hiển thị theo giờ Việt Nam (UTC+7).
    @if (Model.LaChuNha) { <text>Xác nhận lịch hẹn cho các yêu cầu của phòng mình đang quản lý.</text> }
    else { <text>Theo dõi các yêu cầu xem phòng và thuê ngay của bạn.</text> }
</p>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-3">
        <label asp-for="TrangThai" class="form-label">Trạng thái</label>
        <select asp-for="TrangThai" class="form-select">
            @foreach (var option in Model.TrangThaiOptions) { <option value="@option.Value">@option.Text</option> }
        </select>
    </div>
    <div class="col-md-3">
        <label asp-for="Loai" class="form-label">Loại yêu cầu</label>
        <select asp-for="Loai" class="form-select">
            @foreach (var option in Model.LoaiOptions) { <option value="@option.Value">@option.Text</option> }
        </select>
    </div>
    @if (Model.ToaNhas.Count > 0) {
    <div class="col-md-3">
        <label asp-for="ToaNhaId" class="form-label">Tòa nhà</label>
        <select asp-for="ToaNhaId" class="form-select">
            <option value="">Tất cả</option>
            @foreach (var option in Model.ToaNhas) { <option value="@option.Value">@option.Text</option> }
        </select>
    </div>
    }
    <div class="col-md-3 d-flex align-items-end gap-2">
        <button class="btn btn-primary" type="submit">Lọc</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Xóa bộ lọc</a>
    </div>
</form>

@if (Model.YeuCaus.Count == 0) {
    <p>Chưa có yêu cầu nào phù hợp.</p>
} else {
<div class="table-responsive">
<table class="table align-top">
    <thead><tr>
        <th>Mã yêu cầu</th><th>Phòng</th><th>Tòa nhà</th><th>Khách</th><th>Loại</th>
        <th>Lịch hẹn</th><th>Trạng thái</th><th></th>
    </tr></thead>
    <tbody>
    @foreach (var row in Model.YeuCaus) {
    <tr>
        <td>@row.MaYeuCau</td>
        <td>@row.TenPhong</td>
        <td>@row.TenToaNha</td>
        <td>@row.TenKhach <span class="text-muted">@row.SoDienThoaiKhach</span></td>
        <td>@YeuCauThueTrangThai.LoaiLabel(row.LoaiYeuCau)</td>
        <td>
            @if (row.LichHen is { } lichHen) { <text>@YeuCauThueService.HienThoiGio(lichHen)</text> }
            else { <text>—</text> }
            @if (row.DaDoiLich) { <span class="text-muted">(đã đổi lịch)</span> }
        </td>
        <td>@YeuCauThueTrangThai.Label(row.TrangThai)</td>
        <td><a class="btn btn-outline-primary" asp-action="Detail" asp-route-id="@row.Id">Chi tiết</a></td>
    </tr>
    }
    </tbody>
</table>
</div>
}
