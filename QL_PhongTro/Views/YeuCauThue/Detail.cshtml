@model QL_PhongTro.ViewModels.YeuCauThueDetailViewModel
@using QL_PhongTro.Models
@using QL_PhongTro.Services
@{
    ViewData["Title"] = "Chi tiết yêu cầu " + Model.YeuCau.MaYeuCau;
    var ok = TempData["YeuCauThueOk"] as string;
    var err = TempData["YeuCauThueError"] as string;
}
<p class="eyebrow">YÊU CẦU THUÊ</p>
<h1>@Model.YeuCau.MaYeuCau</h1>
<p>
    <a asp-action="Index">← Về danh sách</a> ·
    Phòng <strong>@Model.TenPhong</strong> · @Model.TenToaNha
    @if (!string.IsNullOrWhiteSpace(Model.DiaChiToaNha)) { <text>· @Model.DiaChiToaNha</text> }
</p>

@if (ok is not null) { <p class="text-success">@ok</p> }
@if (err is not null) { <p class="text-danger">@err</p> }

<div class="table-responsive mb-4">
<table class="table align-top">
    <tbody>
    <tr><th>Loại yêu cầu</th><td>@YeuCauThueTrangThai.LoaiLabel(Model.YeuCau.LoaiYeuCau)</td></tr>
    <tr><th>Trạng thái</th><td>@YeuCauThueTrangThai.Label(Model.YeuCau.TrangThai)</td></tr>
    <tr><th>Khách</th><td>@Model.TenKhach @if (!string.IsNullOrWhiteSpace(Model.SoDienThoaiKhach)) { <text>· @Model.SoDienThoaiKhach</text> }</td></tr>
    @if (!Model.LaChuNha) { <tr><th>Chủ nhà</th><td>@Model.TenChuNha</td></tr> }
    <tr><th>Ngày mong muốn</th><td>@Model.YeuCau.NgayMongMuon.ToString("dd/MM/yyyy")</td></tr>
    <tr><th>Số người dự kiến</th><td>@Model.YeuCau.SoNguoiDuKien</td></tr>
    @if (!string.IsNullOrWhiteSpace(Model.YeuCau.LoiNhan)) { <tr><th>Lý do</th><td>@Model.YeuCau.LoiNhan</td></tr> }
    <tr>
        <th>Lịch hẹn</th>
        <td>
            @if (Model.YeuCau.LichHen is { } lichHen) { <text>@YeuCauThueService.HienThoiGio(lichHen)</text> }
            else { <text>Chưa có lịch hẹn</text> }
        </td>
    </tr>
    </tbody>
</table>
</div>

@if (Model.HienThiFormXacNhan) {
<h2>Xác nhận lịch hẹn</h2>
<form method="post" class="row g-3 mb-4" asp-action="XacNhan">
    <input type="hidden" asp-for="YeuCau.Id" />
    <div class="col-md-4">
        <label asp-for="LichHenMoi" class="form-label">Ngày giờ hẹn (giờ Việt Nam)</label>
        <input asp-for="LichHenMoi" type="datetime-local" class="form-control" />
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <button class="btn btn-primary" type="submit">Xác nhận lịch</button>
    </div>
</form>
}
