@model QL_PhongTro.ViewModels.HopDongDetailsViewModel
@{ViewData["Title"]="Hợp đồng & người ở ghép";var people=Context.Request.Query["tab"]=="people"||!ViewData.ModelState.IsValid;var k=Model.Ky;var signer=Model.DungTen;var count=Model.Nguois.Count+(signer==null?0:1);var vi=System.Globalization.CultureInfo.GetCultureInfo("vi-VN");}
<div class="contract-page"><a asp-action="Index" class="contract-back">← Quay lại danh sách</a>
<div class="contract-heading"><div><h1>@(people?"Người ở trong hợp đồng":$"Hợp đồng {Model.HopDong.MaHopDong}")</h1><p>@Model.HopDong.MaHopDong · Phòng @Model.Phong · @Model.ToaNha</p></div><a class="btn btn-outline-primary" asp-action="LichSuNguoiO" asp-route-phongId="@Model.HopDong.PhongId">◷ Lịch sử người ở</a></div>
@if(TempData["ContractSuccess"] is {} message){<div class="alert alert-success">@message</div>}
@if(TempData["ContractWarning"] is {} warning){<div class="alert alert-warning">@warning</div>}
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<nav class="lease-detail-tabs"><a class="@(!people?"is-active":"")" asp-action="Details" asp-route-id="@Model.HopDong.Id">Tổng quan</a><a class="@(people?"is-active":"")" asp-action="Details" asp-route-id="@Model.HopDong.Id" asp-route-tab="people">Người ở cùng (@Model.Nguois.Count)</a><span>Lịch sử thanh toán · Chưa có</span></nav>
@if(people){<partial name="_Residents" model="Model"/>}else{
<div class="lease-workspace detail-workspace"><div><section class="contract-card"><div class="contract-card-title"><span class="contract-icon">▤</span><h2>Thông tin hợp đồng</h2><span class="contract-badge">@(Model.HopDong.TrangThai switch{"DANG_HIEU_LUC"=>"Đang hiệu lực","CHO_HIEU_LUC"=>"Chờ hiệu lực","NHAP"=>"Nháp","DA_KET_THUC"=>"Đã kết thúc","DA_HUY"=>"Đã hủy",_=>Model.HopDong.TrangThai})</span></div>
<dl class="lease-info"><dt>Khách thuê</dt><dd>@(signer?.HoTen??"Chưa cập nhật")</dd><dt>Ngày bắt đầu</dt><dd>@(k?.NgayBatDau.ToString("dd/MM/yyyy")??"Chưa cập nhật")</dd><dt>Số điện thoại</dt><dd>@(signer?.SoDienThoai??"Chưa cập nhật")</dd><dt>Ngày kết thúc</dt><dd>@(k?.NgayKetThuc.ToString("dd/MM/yyyy")??"Chưa cập nhật")</dd><dt>Căn cước</dt><dd>@(signer?.SoGiayTo??"Chưa cập nhật")</dd><dt>Kỳ hạn</dt><dd>@(k?.SoThang.ToString()??"—") tháng</dd><dt>Phòng thuê</dt><dd>@Model.Phong</dd><dt>Ngày chốt tiền</dt><dd>Ngày @Model.HopDong.NgayChot.ToString("00")</dd></dl>
@if(k!=null){<div class="lease-attention"><strong>Thời hạn hợp đồng</strong><span>@k.NgayBatDau.ToString("dd/MM/yyyy") — @k.NgayKetThuc.ToString("dd/MM/yyyy")</span><small>@(k.NgayKetThuc>=Model.HomNay?$"Còn {k.NgayKetThuc.DayNumber-Model.HomNay.DayNumber+1} ngày đến ngày kết thúc":"Đã qua ngày kết thúc")</small></div>}</section>
<section class="contract-card"><h2>Tài chính hợp đồng</h2><div class="lease-finance"><div><small>Giá thuê</small><strong>@(k?.GiaThue.ToString("N0",vi)??"—") đ/tháng</strong></div><div><small>Tiền cọc thỏa thuận</small><strong>@Model.HopDong.TienCoc.ToString("N0",vi) đ</strong></div><div><small>Thanh toán / dư nợ</small><strong>Chưa có dữ liệu</strong></div></div></section>
<section class="contract-card"><h2>Chỉ số bàn giao đầu kỳ</h2>@if(Model.ChiSo is {} meter){<div class="lease-finance"><div><small>Điện</small><strong>@meter.ChiSoDien.ToString("N3",vi) kWh</strong></div><div><small>Nước</small><strong>@meter.ChiSoNuoc.ToString("N3",vi) m³</strong></div><div><small>Ngày bàn giao</small><strong>@meter.NgayBanGiao.ToString("dd/MM/yyyy")</strong></div></div>}else{<p class="contract-note">Chưa ghi nhận chỉ số bàn giao cho hợp đồng này.</p>}</section><section class="contract-card"><h2>Trách nhiệm người đứng tên</h2><p class="contract-note">Người đứng tên chịu trách nhiệm thanh toán và là người nhận lại tiền cọc của hợp đồng.</p></section>
</div><aside><section class="contract-card"><h2>Người đứng tên hợp đồng</h2><div class="lease-person"><span class="lease-avatar">@(signer?.HoTen.FirstOrDefault().ToString()??"?")</span><div><strong>@(signer?.HoTen??"Chưa cập nhật")</strong><small>@signer?.SoDienThoai</small><small>CCCD @signer?.SoGiayTo</small></div></div></section><section class="contract-card"><h2>Người đang ở</h2><div class="capacity-number">@count / @Model.GioiHan người</div><div class="lease-progress"><span style="width:@Math.Clamp(count*100/Math.Max(1,Model.GioiHan),0,100)%"></span></div><p class="contract-note">Còn @Math.Max(0,Model.GioiHan-count) vị trí hôm nay</p><a class="btn btn-primary lease-full" asp-action="Details" asp-route-id="@Model.HopDong.Id" asp-route-tab="people">Quản lý người ở ghép</a></section><section class="contract-card"><h2>Việc cần chú ý</h2><p class="contract-note">Tiền cọc là mức thỏa thuận, không phải tiền thực nhận.</p><p class="contract-note">Gia hạn, tải PDF, chỉnh sửa và kết thúc hợp đồng chưa được triển khai.</p></section></aside></div>}
</div>
@section Styles{<link rel="stylesheet" href="~/css/contracts.css" asp-append-version="true"/>}
