@model List<QL_PhongTro.ViewModels.HopDongDanhSach>
@inject QL_PhongTro.Authorization.PermissionService Permissions
@{ ViewData["Title"]="Hợp đồng & người ở ghép"; var today=(DateOnly)ViewData["HomNay"]!; var active=Model.Count(x=>x.HopDong.TrangThai=="DANG_HIEU_LUC"); var ending=Model.Count(x=>x.HopDong.TrangThai=="DANG_HIEU_LUC"&&x.Ky is {} k&&k.NgayKetThuc>=today&&k.NgayKetThuc<=today.AddDays(30)); var vi=System.Globalization.CultureInfo.GetCultureInfo("vi-VN"); }
<div class="contract-page contract-list"><div class="contract-heading"><div><h1>Hợp đồng thuê</h1><p>Quản lý thời hạn thuê, tiền cọc và trạng thái hợp đồng.</p></div>@if(await Permissions.AllowsAsync("HOP_DONG",true)){<a class="btn btn-primary" asp-action="Create">＋ Lập hợp đồng thuê</a>}</div>
@if(TempData["ContractSuccess"] is {} message){<div class="alert alert-success">@message</div>}
<div class="lease-stats">
<section class="contract-card"><span class="contract-icon">▤</span><div>Tổng hợp đồng<strong>@Model.Count.ToString("00")</strong><small>Tất cả hợp đồng đang quản lý</small></div></section>
<section class="contract-card"><span class="contract-icon">✓</span><div>Đang hiệu lực<strong>@active.ToString("00")</strong><small>Theo trạng thái hợp đồng</small></div></section>
<section class="contract-card"><span class="contract-icon">◷</span><div>Sắp hết hạn<strong>@ending.ToString("00")</strong><small>Trong 30 ngày tới</small></div></section>
<section class="contract-card"><span class="contract-icon">▱</span><div>Tổng tiền cọc<strong>@Model.Sum(x=>(decimal)x.HopDong.TienCoc).ToString("N0",vi) đ</strong><small>Tiền cọc thỏa thuận, chưa phải tiền đã thu</small></div></section></div>
<div class="lease-workspace"><section class="contract-card"><div class="contract-card-title"><h2>Danh sách hợp đồng</h2><span class="contract-badge">@Model.Count hợp đồng</span></div>
<div class="lease-tabs" id="lease-filters"><button type="button" data-status="" class="is-active">Tất cả (@Model.Count)</button><button type="button" data-status="DANG_HIEU_LUC">Đang hiệu lực (@active)</button><button type="button" data-status="ending">Sắp hết hạn (@ending)</button><button type="button" data-status="DA_KET_THUC">Đã kết thúc</button></div>
<div class="lease-filter-row"><input id="lease-search" aria-label="Tìm hợp đồng" placeholder="Tìm mã hợp đồng, khách thuê, phòng..."/><select id="lease-building" aria-label="Lọc tòa nhà"><option value="">Tất cả tòa nhà</option>@foreach(var b in Model.Select(x=>x.ToaNha).Distinct()){<option>@b</option>}</select><select id="lease-status" aria-label="Lọc trạng thái"><option value="">Tất cả trạng thái</option><option value="NHAP">Nháp</option><option value="CHO_HIEU_LUC">Chờ hiệu lực</option><option value="DANG_HIEU_LUC">Đang hiệu lực</option><option value="DA_KET_THUC">Đã kết thúc</option><option value="DA_HUY">Đã hủy</option></select></div>
<div class="table-responsive"><table class="table lease-table"><thead><tr><th>STT</th><th>Hợp đồng</th><th>Khách thuê</th><th>Phòng / Tòa nhà</th><th>Thời hạn thuê</th><th>Tiền cọc</th><th>Ngày chốt tiền</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@for(var i=0;i<Model.Count;i++){var r=Model[i];var h=r.HopDong;var k=r.Ky;var soon=h.TrangThai=="DANG_HIEU_LUC"&&k!=null&&k.NgayKetThuc>=today&&k.NgayKetThuc<=today.AddDays(30);<tr data-lease-row data-building="@r.ToaNha" data-status="@h.TrangThai" data-ending="@(soon?"yes":"no")"><td>@(i+1)</td><td><strong>@h.MaHopDong</strong><small>Tạo: @h.NgayTao.AddHours(7).ToString("dd/MM/yyyy")</small></td><td>@(r.Khach??"Chưa cập nhật")</td><td>@r.Phong<small>@r.ToaNha</small></td><td>@if(k!=null){<span>@k.NgayBatDau.ToString("dd/MM/yyyy") — @k.NgayKetThuc.ToString("dd/MM/yyyy")</span><div class="lease-progress"><span style="width:@Math.Clamp((today.DayNumber-k.NgayBatDau.DayNumber)*100/Math.Max(1,k.NgayKetThuc.DayNumber-k.NgayBatDau.DayNumber),0,100)%"></span></div><small>@(k.NgayKetThuc>=today?$"Còn {k.NgayKetThuc.DayNumber-today.DayNumber+1} ngày":"Đã qua ngày kết thúc")</small>}else{<span>Chưa có kỳ thuê</span>}</td><td>@h.TienCoc.ToString("N0",vi) đ</td><td>Ngày @h.NgayChot.ToString("00")</td><td><span class="contract-badge @(soon?"badge-warning":h.TrangThai=="DANG_HIEU_LUC"?"badge-success":"")">@(soon?"Sắp hết hạn":h.TrangThai switch{"DANG_HIEU_LUC"=>"Đang hiệu lực","NHAP"=>"Nháp","CHO_HIEU_LUC"=>"Chờ hiệu lực","DA_KET_THUC"=>"Đã kết thúc","DA_HUY"=>"Đã hủy",_=>h.TrangThai})</span></td><td>@if(User.IsInRole("CHU_NHA")){<a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@h.Id">Chi tiết</a>}</td></tr>}
</tbody></table></div><p id="lease-empty" hidden>Không có hợp đồng phù hợp.</p><small id="lease-count">Hiển thị @Model.Count hợp đồng</small></section>
<aside><section class="contract-card"><h2>Cần chú ý</h2><div class="lease-attention"><strong>@ending hợp đồng sắp hết hạn</strong><small>Kiểm tra thời hạn trong 30 ngày tới</small></div><div class="lease-attention"><strong>@Model.Count(x=>x.HopDong.TienCoc==0) hợp đồng có tiền cọc bằng 0</strong><small>Đây là tiền cọc thỏa thuận</small></div></section><section class="contract-card"><h2>Thông tin quản lý</h2><p class="contract-note">Chọn Chi tiết để xem thông tin thuê, chỉ số bàn giao và quản lý người ở ghép.</p><p class="contract-note">Lịch sử thu tiền, xuất PDF và gia hạn chưa được triển khai trong màn này.</p></section></aside></div></div>
@section Styles{<link rel="stylesheet" href="~/css/contracts.css" asp-append-version="true"/>}
@section Scripts{<script src="~/js/lease-list.js" asp-append-version="true"></script>}
