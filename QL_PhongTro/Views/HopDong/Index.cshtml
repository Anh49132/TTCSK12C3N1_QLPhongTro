@model List<QL_PhongTro.ViewModels.HopDongDanhSach>
@inject QL_PhongTro.Authorization.PermissionService Permissions
@{ ViewData["Title"] = "Hợp đồng & người ở ghép"; }
<div class="contract-page">
<div class="contract-heading"><div><h1>Hợp đồng thuê</h1><p>Thông tin thuê được lập từ yêu cầu đã duyệt.</p></div>@if (await Permissions.AllowsAsync("HOP_DONG", true)) { <a class="btn btn-primary" asp-action="Create">+ Lập hợp đồng thuê</a> }</div>
@if (TempData["ContractSuccess"] is { } message) { <div class="alert alert-success">@message</div> }
<section class="contract-card"><div class="table-responsive"><table class="table"><thead><tr><th>STT</th><th>Hợp đồng</th><th>Khách thuê</th><th>Phòng / Tòa nhà</th><th>Tiền cọc</th><th>Ngày chốt</th><th>Trạng thái</th></tr></thead><tbody>
@for (var i = 0; i < Model.Count; i++) { var row = Model[i]; var h = row.HopDong; <tr><td>@(i+1)</td><td>@if (User.IsInRole("CHU_NHA")) { <a asp-action="Details" asp-route-id="@h.Id">@h.MaHopDong</a> } else { @h.MaHopDong }</td><td>@(row.Khach ?? "Chưa cập nhật")</td><td>@row.Phong — @row.ToaNha</td><td>@h.TienCoc.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) đ</td><td>@h.NgayChot</td><td><span class="contract-badge">@(h.TrangThai == "DANG_HIEU_LUC" ? "Đang hiệu lực" : h.TrangThai == "NHAP" ? "Nháp" : h.TrangThai)</span></td></tr> }
@if (Model.Count == 0) { <tr><td colspan="7">Chưa có hợp đồng. Chọn yêu cầu đã duyệt để bắt đầu.</td></tr> }
</tbody></table></div></section></div>
@section Styles { <link rel="stylesheet" href="~/css/contracts.css" asp-append-version="true" /> }
