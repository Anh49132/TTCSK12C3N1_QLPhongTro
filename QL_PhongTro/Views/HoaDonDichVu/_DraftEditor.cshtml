@model QL_PhongTro.Models.HoaDon
@using System.Globalization
<section class="mi-card">
<h2>Sửa hóa đơn Nháp</h2>
<p>Chỉ sửa chỉ số trên hóa đơn; đơn giá giữ nguyên. Bản nháp chưa gửi thông báo cho khách.</p>
<form asp-action="SaveDraft" method="post">
<input type="hidden" name="Id" value="@Model.Id" />
<input type="hidden" name="PhienBan" value="@Model.PhienBan" />
@{ var readings = Model.ChiTiet.Where(x => x.CachTinhApDung == "THEO_CHI_SO").OrderBy(x => x.SoThuTu).ToList(); }
@for (var i = 0; i < readings.Count; i++) {
<fieldset class="mb-3"><legend class="fs-6">@readings[i].TenKhoan (@readings[i].DonViTinh)</legend>
<input type="hidden" name="ChiSo[@i].Id" value="@readings[i].Id" />
<label for="start-@i">Chỉ số đầu</label><input id="start-@i" class="form-control" type="number" min="0" max="99999999999.999" step="0.001" name="ChiSo[@i].ChiSoDau" value="@readings[i].ChiSoDau?.ToString(CultureInfo.InvariantCulture)" required />
<label for="end-@i">Chỉ số cuối</label><input id="end-@i" class="form-control" type="number" min="0" max="99999999999.999" step="0.001" name="ChiSo[@i].ChiSoCuoi" value="@readings[i].ChiSoCuoi?.ToString(CultureInfo.InvariantCulture)" required />
</fieldset>
}
@for (var i = 0; i < 2; i++) {
<fieldset class="mb-3"><legend class="fs-6">Thêm @(i == 0 ? "khoản phát sinh" : "khoản giảm trừ") (không bắt buộc)</legend>
<input type="hidden" name="Khoan[@i].LoaiKhoan" value="@(i == 0 ? "PHAT_SINH" : "GIAM_TRU")" />
<label for="charge-name-@i">Tên khoản</label><input id="charge-name-@i" class="form-control" name="Khoan[@i].TenKhoan" maxlength="200" />
<label for="charge-amount-@i">Số tiền (đồng)</label><input id="charge-amount-@i" class="form-control" type="number" name="Khoan[@i].SoTien" min="1" step="1" />
<label for="charge-note-@i">Ghi chú (bắt buộc khi thêm khoản)</label><textarea id="charge-note-@i" class="form-control" name="Khoan[@i].GhiChu" maxlength="1000"></textarea>
</fieldset>
}
<button class="btn btn-dark">Lưu thay đổi và tính lại tổng</button>
</form></section>
