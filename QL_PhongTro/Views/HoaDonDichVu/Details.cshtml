@model QL_PhongTro.Models.HoaDon
@using System.Globalization
@{ ViewData["Title"] = "Chi tiết hóa đơn"; var vn = CultureInfo.GetCultureInfo("vi-VN"); }
<a asp-action="Index" asp-route-toaNhaId="@ViewData["ToaNhaId"]">← Danh sách hóa đơn</a>
<h1 class="h2 mt-3">Hóa đơn @Model.MaHoaDon</h1>
<p>Kỳ @Model.Thang/@Model.Nam · Ngày chốt @Model.NgayChot.ToString("dd/MM/yyyy") · Số người tính phí đã lưu: <strong>@Model.SoNguoiTinhPhi người</strong></p>
<p>Trạng thái: @(Model.TrangThai == "DA_PHAT_HANH" ? "Đã phát hành" : Model.TrangThai) · Hạn thanh toán: @Model.HanThanhToan.ToString("dd/MM/yyyy")</p>
<div class="table-responsive"><table class="table"><thead><tr><th>Khoản thu</th><th>Đơn vị</th><th>Chỉ số đầu/cuối</th><th class="text-end">Số lượng</th><th class="text-end">Đơn giá</th><th class="text-end">Thành tiền</th></tr></thead><tbody>
@foreach (var line in Model.ChiTiet.OrderBy(x => x.SoThuTu))
{
    <tr><td>@line.TenKhoan</td><td>@line.DonViTinh</td><td>@(line.ChiSoDau.HasValue ? $"{line.ChiSoDau.Value.ToString("0.###", vn)} / {line.ChiSoCuoi?.ToString("0.###", vn)}" : "—")</td><td class="text-end">@line.SoLuong.ToString("0.###", vn)</td><td class="text-end">@line.DonGia.ToString("N0", vn)</td><td class="text-end">@line.ThanhTien.ToString("N0", vn) đ</td></tr>
}
</tbody><tfoot><tr><th colspan="5">Tổng cộng</th><th class="text-end">@Model.TongTien.ToString("N0", vn) đ</th></tr></tfoot></table></div>
<p class="text-secondary">Số người, đơn giá và thành tiền được lưu tại thời điểm phát hành. Thay đổi danh sách người ở hoặc bảng giá dịch vụ không làm thay đổi hóa đơn này.</p>
