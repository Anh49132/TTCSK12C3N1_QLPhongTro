@model QL_PhongTro.ViewModels.PhatHanhThangViewModel
@using System.Globalization
@inject QL_PhongTro.Authorization.PermissionService Permissions
@{ ViewData["Title"] = "Phát hành hóa đơn tháng"; var vn = CultureInfo.GetCultureInfo("vi-VN"); var write = await Permissions.AllowsAsync("TAI_CHINH", true); }
@section Styles { <link rel="stylesheet" href="~/css/monthly-invoices.css" asp-append-version="true" /> }
<div class="monthly-invoices">
<nav aria-label="Đường dẫn" class="mi-breadcrumb"><a asp-controller="Home" asp-action="Index">Tổng quan</a> / Hóa đơn, thanh toán / Phát hành hóa đơn</nav>
<header class="mi-heading"><div><h1>Phát hành hóa đơn tháng</h1><p>Tính và tạo hóa đơn cho các phòng đã chốt đủ điện nước trong một lần.</p></div><a href="#invoice-history" class="btn btn-outline-secondary">◷ Lịch sử phát hành</a></header>
<ol class="mi-steps"><li><b>1</b> Cấu hình kỳ</li><li><b>2</b> Kiểm tra hóa đơn</li><li><b>3</b> Phát hành</li></ol>
<div asp-validation-summary="All" class="text-danger"></div>
@if (TempData["MonthlyMessage"] is string message) { <div class="alert alert-success" role="status">@message</div> }
@if (TempData["MonthlyError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
<div class="mi-columns">
<div>
<section class="mi-card"><h2>Thông tin kỳ hóa đơn</h2><p class="mi-info">ⓘ Kỳ theo tháng dương lịch. Đơn giá lấy tại ngày chốt của từng hợp đồng, giới hạn tới ngày cuối tháng.</p>
<form asp-action="Monthly" method="get" class="mi-fields">
<div class="mi-wide"><label asp-for="ToaNhaId">Tòa nhà <span>*</span></label><select asp-for="ToaNhaId" asp-items="Model.ToaNhas" class="form-select" required><option value="">Chọn tòa nhà</option></select></div>
<div><label asp-for="Thang">Tháng áp dụng <span>*</span></label><select asp-for="Thang" class="form-select">@for (var m = 1; m <= 12; m++) { <option value="@m">Tháng @m</option> }</select></div>
<div><label asp-for="Nam">Năm <span>*</span></label><input asp-for="Nam" type="number" min="1900" max="9998" class="form-control" required /></div>
<div class="mi-wide"><button class="btn btn-dark">Kiểm tra hóa đơn</button></div>
</form>
<p class="mi-muted">Hạn thanh toán tự động: 7 ngày kể từ ngày phát hành. Tiền phòng lấy theo kỳ hợp đồng thuê trọn tháng.</p>
</section>
<section class="mi-card"><h2>Hóa đơn sẵn sàng phát hành</h2><p class="mi-muted">Chỉ gồm tiền phòng, điện và nước theo chỉ số. Đơn giá và chỉ số được lưu vào từng hóa đơn.</p>
@if (!Model.SanSang) { <div class="alert alert-info">Chưa có tòa nhà hoặc chức năng hóa đơn/chỉ số chưa được thiết lập. Vui lòng liên hệ quản trị.</div> }
else if (Model.DuKien.Count == 0) { <p>Không có phòng đủ điều kiện tạo hóa đơn mới trong kỳ này.</p> }
else {
<div class="table-responsive"><table class="table mi-table"><thead><tr><th>Phòng</th><th>Ngày chốt</th><th>Tiền phòng</th><th>Tiền điện</th><th>Tiền nước</th><th>Tổng tiền</th></tr></thead><tbody>
@foreach (var row in Model.DuKien) {
<tr><th>@row.MaPhong</th><td>@row.HoaDon.NgayChot.ToString("dd/MM/yyyy")</td>@foreach (var line in row.HoaDon.ChiTiet) { <td>@line.ThanhTien.ToString("N0", vn) đ</td> }<td><strong>@row.HoaDon.TongTien.ToString("N0", vn) đ</strong></td></tr>
<tr><td colspan="6"><details><summary>Xem chỉ số và đơn giá · @row.MaPhong</summary>@foreach (var line in row.HoaDon.ChiTiet.Where(x => x.DichVuId.HasValue)) { <p>@line.TenKhoan: @line.ChiSoDau?.ToString("0.###", vn) → @line.ChiSoCuoi?.ToString("0.###", vn) · @line.SoLuong.ToString("0.###", vn) @line.DonViTinh × @line.DonGia.ToString("N0", vn) đ = <strong>@line.ThanhTien.ToString("N0", vn) đ</strong></p> }</details></td></tr>
}
</tbody></table></div>
}
</section>
</div>
<aside><section class="mi-card"><h2>Kiểm tra dữ liệu đầu vào</h2><div class="mi-stats"><div><span>Phòng đang thuê</span><strong>@Model.TongPhong</strong><small>Hợp đồng đang hiệu lực</small></div><div class="mi-ready"><span>Sẵn sàng phát hành</span><strong>@Model.DuKien.Count</strong><small>Đủ chỉ số và đơn giá</small></div></div><h3>Sẵn sàng tạo @Model.DuKien.Count hóa đơn</h3><progress value="@Model.DuKien.Count" max="@Math.Max(1, Model.TongPhong)"></progress><p class="mi-muted">@Model.DuKien.Count/@Model.TongPhong phòng đủ điều kiện.</p></section>
<section class="mi-card"><h2>Phát hành đúng dữ liệu</h2><p>Phòng thiếu chỉ số điện hoặc nước, thiếu đơn giá hay chưa có kỳ thuê trọn tháng sẽ không được phát hành.</p><p class="mi-warning">ⓘ Kiểm tra thông tin trước khi phát hành. Hóa đơn đã phát hành giữ nguyên nội dung và khóa chỉ số kỳ này.</p></section></aside>
</div>
<section class="mi-card" id="invoice-history"><h2>Hóa đơn đã phát hành · @Model.Thang/@Model.Nam</h2>
@if (Model.DaPhatHanh.Count == 0) { <p>Chưa có hóa đơn đã phát hành trong kỳ này.</p> }
else { <div class="table-responsive"><table class="table"><thead><tr><th>Phòng</th><th>Mã hóa đơn</th><th>Tổng tiền</th><th></th></tr></thead><tbody>@foreach (var row in Model.DaPhatHanh) { <tr><th>@row.MaPhong</th><td>@row.HoaDon.MaHoaDon</td><td>@row.HoaDon.TongTien.ToString("N0", vn) đ</td><td><a asp-action="Details" asp-route-id="@row.HoaDon.Id">Xem chi tiết</a></td></tr> }</tbody></table></div> }
</section>
<footer class="mi-footer"><strong>Có thể phát hành @Model.DuKien.Count hóa đơn</strong><form asp-action="IssueMonthly" method="post"><input type="hidden" asp-for="ToaNhaId" /><input type="hidden" asp-for="Nam" /><input type="hidden" asp-for="Thang" /><a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Hủy</a><button class="btn btn-dark" disabled="@(!write || !Model.SanSang || Model.DuKien.Count == 0)">Phát hành hóa đơn tháng →</button></form></footer>
</div>
