@model QL_PhongTro.ViewModels.Auth.ForgotPasswordViewModel
@{ ViewData["Title"] = "Quên mật khẩu"; }
<section class="auth-card"><h1>Quên mật khẩu</h1>
@if (TempData["ResetRequestMessage"] is string message) { <div class="alert alert-success" role="status">@message</div> }
<p>Nhập email tài khoản Khách thuê để nhận liên kết đặt lại mật khẩu.</p>
<form asp-action="ForgotPassword" method="post">
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div class="mb-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" type="email" autocomplete="email" class="form-control" required /><span asp-validation-for="Email" class="text-danger"></span></div>
<button type="submit" class="btn btn-primary">Gửi liên kết đặt lại</button>
</form><p class="auth-bottom"><a asp-action="Login">Về đăng nhập</a></p></section>
