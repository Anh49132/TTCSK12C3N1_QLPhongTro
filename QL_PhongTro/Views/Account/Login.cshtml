@model QL_PhongTro.ViewModels.Auth.LoginRequest
@{ ViewData["Title"] = "Đăng nhập"; Layout = "~/Views/Shared/_Layout.cshtml"; }
@section Scripts {
    <script src="~/js/auth-interceptor.js" asp-append-version="true"></script>
    <script>
        (function () {
            var form = document.getElementById('loginForm');
            var errorEl = document.getElementById('loginError');
            var lockoutAlert = document.getElementById('lockoutAlert');
            var lockoutMessage = document.getElementById('lockoutMessage');
            var countdownTimer = document.getElementById('countdownTimer');
            var countdownInterval = null;
            var useApi = form.dataset.useApi === 'true';

            function showLockout(seconds) {
                errorEl.textContent = '';
                lockoutAlert.classList.remove('d-none');
                var endTime = Date.now() + seconds * 1000;
                countdownInterval = setInterval(function () {
                    var remaining = Math.max(0, Math.ceil((endTime - Date.now()) / 1000));
                    var mins = Math.floor(remaining / 60);
                    var secs = remaining % 60;
                    countdownTimer.textContent = mins + ':' + (secs < 10 ? '0' : '') + secs;
                    if (remaining <= 0) {
                        clearInterval(countdownInterval);
                        lockoutAlert.classList.add('d-none');
                    }
                }, 1000);
            }

            function hideLockout() {
                if (countdownInterval) {
                    clearInterval(countdownInterval);
                    countdownInterval = null;
                }
                lockoutAlert.classList.add('d-none');
            }

            if (form) {
                form.addEventListener('submit', async function (e) {
                    if (useApi) {
                        e.preventDefault();
                        errorEl.textContent = '';
                        hideLockout();

                        var taiKhoan = document.getElementById('TaiKhoanDangNhap').value.trim();
                        var pwd = document.getElementById('MatKhau').value;

                        if (!taiKhoan) {
                            errorEl.textContent = 'Phải nhập số điện thoại hoặc email';
                            return;
                        }
                        if (!pwd || pwd.length < 8) {
                            errorEl.textContent = 'Mật khẩu tối thiểu 8 ký tự';
                            return;
                        }

                        try {
                            var res = await fetch('/api/auth/login', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ TaiKhoanDangNhap: taiKhoan, MatKhau: pwd })
                            });
                            var data = await res.json();
                            if (!res.ok) {
                                errorEl.textContent = data.message || 'Đăng nhập thất bại';
                                if (data.message && data.message.includes('khoá')) {
                                    var match = data.message.match(/(\d+)\s*phút/);
                                    if (match) {
                                        showLockout(parseInt(match[1]) * 60);
                                    }
                                }
                                return;
                            }
                            authSetTokens(data.accessToken, data.refreshToken);
                            window.location.href = data.returnUrl || '/';
                        } catch (err) {
                            errorEl.textContent = 'Lỗi kết nối server';
                        }
                    }
                    // If not useApi, let the form submit normally to MVC endpoint
                });
            }
        })();
    </script>
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <section class="auth-card">
                <p class="eyebrow">CHÀO MỪNG TRỞ LẠI</p>
                <h1>Đăng nhập</h1>
                @if (TempData["PasswordSuccess"] is string success) { <div class="alert alert-success" role="status">@success</div> }
                <p class="auth-description">Tiếp tục quản lý không gian sống của bạn.</p>
                <form id="loginForm" method="post" data-use-api="false" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert" id="loginError"></div>
                    <input asp-for="ReturnUrl" type="hidden" />
                    <div class="mb-3">
                        <label asp-for="TaiKhoanDangNhap" class="form-label">Số điện thoại hoặc Email</label>
                        <input asp-for="TaiKhoanDangNhap" class="form-control" autocomplete="username" placeholder="Nhập số điện thoại hoặc email" />
                        <span asp-validation-for="TaiKhoanDangNhap" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="MatKhau" class="form-label">Mật khẩu</label>
                        <input asp-for="MatKhau" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                        <span asp-validation-for="MatKhau" class="text-danger"></span>
                    </div>
                    <!-- Lockout countdown -->
                    <div class="mb-3 text-warning d-none" id="lockoutAlert">
                        <div class="alert alert-warning mb-0" role="alert">
                            <strong id="lockoutMessage">Tài khoản đã bị khoá.</strong>
                            <div class="mt-2">
                                <span class="badge bg-warning text-dark" id="countdownTimer"></span>
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100" id="loginBtn">Đăng nhập</button>
                </form>
                <p class="auth-bottom"><a asp-action="ForgotPassword">Quên mật khẩu?</a></p>
                <p class="auth-bottom">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p>
            </section>
        </div>
    </div>
</div>