@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Đăng nhập</h2>
    <form id="loginForm" novalidate>
        <div class="mb-3">
            <label for="TaiKhoanDangNhap" class="form-label">Số điện thoại hoặc Email</label>
            <input type="text" class="form-control" id="TaiKhoanDangNhap" name="TaiKhoanDangNhap" placeholder="Nhập số điện thoại hoặc email" />
            <div class="text-danger field-validation" data-valmsg-for="TaiKhoanDangNhap"></div>
        </div>

        <div class="mb-3">
            <label for="MatKhau" class="form-label">Mật khẩu</label>
            <input type="password" class="form-control" id="MatKhau" name="MatKhau" />
            <div class="text-danger field-validation" data-valmsg-for="MatKhau"></div>
        </div>

        <div class="mb-3 text-danger" id="loginError"></div>

        <!-- Lockout countdown -->
        <div class="mb-3 text-warning d-none" id="lockoutAlert">
            <div class="alert alert-warning mb-0" role="alert">
                <strong id="lockoutMessage"></strong>
                <div class="mt-2">
                    <span class="badge bg-warning text-dark" id="countdownTimer"></span>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary" id="loginBtn">Đăng nhập</button>
    </form>
    <p class="mt-3">Chưa có tài khoản? <a href="/Account/Register">Đăng ký</a></p>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('loginForm');
            var errorEl = document.getElementById('loginError');
            var lockoutAlert = document.getElementById('lockoutAlert');
            var lockoutMessage = document.getElementById('lockoutMessage');
            var countdownTimer = document.getElementById('countdownTimer');
            var countdownInterval = null;

            function showLockout(seconds) {
                errorEl.textContent = '';
                lockoutAlert.classList.remove('d-none');
                var endTime = Date.now() + seconds * 1000;
                countdownInterval = setInterval(function () {
                    var remaining = Math.max(0, Math.ceil((endTime - Date.now()) / 1000));
                    var mins = Math.floor(remaining / 60);
                    var secs = remaining % 60;
                    countdownTimer.textContent = mins + ':' + (secs < 10 ? '0' : '') + secs;
                    if (remaining <= 0) {
                        clearInterval(countdownInterval);
                        lockoutAlert.classList.add('d-none');
                    }
                }, 1000);
            }

            function hideLockout() {
                if (countdownInterval) {
                    clearInterval(countdownInterval);
                    countdownInterval = null;
                }
                lockoutAlert.classList.add('d-none');
            }

            if (form) {
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    errorEl.textContent = '';
                    hideLockout();

                    var taiKhoan = document.getElementById('TaiKhoanDangNhap').value.trim();
                    var pwd = document.getElementById('MatKhau').value;
                    var hasError = false;

                    if (!taiKhoan) {
                        errorEl.textContent = 'Phải nhập số điện thoại hoặc email';
                        return;
                    }
                    if (!pwd || pwd.length < 8) {
                        errorEl.textContent = 'Mật khẩu tối thiểu 8 ký tự';
                        return;
                    }

                    try {
                        var res = await fetch('/api/auth/login', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ TaiKhoanDangNhap: taiKhoan, MatKhau: pwd })
                        });
                        var data = await res.json();
                        if (!res.ok) {
                            errorEl.textContent = data.message || 'Đăng nhập thất bại';
                            // Check if account is locked
                            if (data.message && data.message.includes('khoá')) {
                                // Extract seconds from message if possible
                                var match = data.message.match(/(\d+)\s*phút/);
                                if (match) {
                                    showLockout(parseInt(match[1]) * 60);
                                }
                            }
                            return;
                        }
                        // Store tokens
                        authSetTokens(data.accessToken, data.refreshToken);
                        window.location.href = '/';
                    } catch (err) {
                        errorEl.textContent = 'Lỗi kết nối server';
                    }
                });
            }
        })();
    </script>
}