@model QL_PhongTro.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="mx-auto" style="max-width:440px">
<h1 class="h3">Đăng nhập</h1>
<form asp-action="Login" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <input asp-for="ReturnUrl" type="hidden" />
    <div class="mb-3"><label asp-for="Identifier" class="form-label">Email hoặc số điện thoại</label>
    <input asp-for="Identifier" class="form-control" autocomplete="username" />
    <span asp-validation-for="Identifier" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Password" class="form-label">Mật khẩu</label>
    <input asp-for="Password" class="form-control" autocomplete="current-password" />
    <span asp-validation-for="Password" class="text-danger"></span></div>
    <button class="btn btn-primary" type="submit">Đăng nhập</button>
</form>
</div>

