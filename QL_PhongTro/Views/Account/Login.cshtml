@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Đăng nhập</h2>
    <form id="loginForm" novalidate>
        <div class="mb-3">
            <label for="Email" class="form-label">Email</label>
            <input type="email" class="form-control" id="Email" name="Email" />
            <div class="text-danger field-validation" data-valmsg-for="Email"></div>
        </div>

        <div class="mb-3">
            <label for="SoDienThoai" class="form-label">Số điện thoại</label>
            <input type="text" class="form-control" id="SoDienThoai" name="SoDienThoai" />
            <div class="text-danger field-validation" data-valmsg-for="SoDienThoai"></div>
        </div>

        <div class="mb-3">
            <label for="MatKhau" class="form-label">Mật khẩu</label>
            <input type="password" class="form-control" id="MatKhau" name="MatKhau" />
            <div class="text-danger field-validation" data-valmsg-for="MatKhau"></div>
        </div>

        <div class="mb-3 text-danger" id="loginError"></div>

        <button type="submit" class="btn btn-primary">Đăng nhập</button>
    </form>
    <p class="mt-3">Chưa có tài khoản? <a href="/Account/Register">Đăng ký</a></p>
</div>

<script>
    (function () {
        var form = document.getElementById('loginForm');
        var errorEl = document.getElementById('loginError');
        if (form) {
            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                errorEl.textContent = '';

                var email = document.getElementById('Email').value.trim();
                var phone = document.getElementById('SoDienThoai').value.trim();
                var pwd = document.getElementById('MatKhau').value;
                var hasError = false;

                if (!email && (!phone || !/^\d{10}$/.test(phone))) {
                    errorEl.textContent = 'Phải nhập email hoặc số điện thoại hợp lệ';
                    hasError = true;
                }
                if (!pwd || pwd.length < 8) {
                    errorEl.textContent = 'Mật khẩu tối thiểu 8 ký tự';
                    hasError = true;
                }
                if (hasError) return;

                try {
                    var res = await fetch('/api/auth/login', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ Email: email, SoDienThoai: phone, MatKhau: pwd })
                    });
                    var data = await res.json();
                    if (!res.ok) {
                        errorEl.textContent = data.message || 'Đăng nhập thất bại';
                        return;
                    }
                    // Store tokens
                    authSetTokens(data.accessToken, data.refreshToken);
                    window.location.href = '/';
                } catch (err) {
                    errorEl.textContent = 'Lỗi kết nối server';
                }
            });
        }
    })();
</script>
