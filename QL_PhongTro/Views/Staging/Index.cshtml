@model QL_PhongTro.ViewModels.StagingOverviewViewModel
@{
    ViewData["Title"] = "Tổng quan staging";
}

<section class="page-header">
    <div>
        <p class="eyebrow">MÔI TRƯỜNG STAGING</p>
        <h1>Tổng quan dữ liệu mẫu</h1>
    </div>
</section>

<section class="staging-summary" aria-label="Số lượng dữ liệu staging">
    <article><span>Tòa nhà</span><strong>@Model.BuildingCount</strong><small>mục tiêu 2</small></article>
    <article><span>Phòng</span><strong>@Model.RoomCount</strong><small>mục tiêu 30</small></article>
    <article><span>Hợp đồng</span><strong>@Model.ContractCount</strong><small>mục tiêu 20</small></article>
    <article><span>Hóa đơn</span><strong>@Model.InvoiceCount</strong><small>@Model.InvoicePeriodCount kỳ, mục tiêu 3</small></article>
</section>

<section class="staging-states" aria-label="Trạng thái thanh toán hóa đơn">
    <h2>Trạng thái thanh toán</h2>
    <dl>
        <div><dt>Đã thanh toán đủ</dt><dd>@Model.PaidInFullCount</dd></div>
        <div><dt>Đã thanh toán một phần</dt><dd>@Model.PaidPartiallyCount</dd></div>
        <div><dt>Quá hạn, còn dư nợ</dt><dd>@Model.OverdueCount</dd></div>
    </dl>
</section>