@{ var isPropertyPage = ViewContext.RouteData.Values["controller"]?.ToString() == "PhongTro"; }
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - Nhà Trọ</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
@if (isPropertyPage) { <link rel="stylesheet" href="~/css/room-images.css" asp-append-version="true" /> }
</head>
<body>
<a class="skip-link" href="#main-content">Đến nội dung chính</a>
<aside id="app-sidebar" class="dashboard-sidebar" aria-label="Điều hướng ứng dụng">
<partial name="_Sidebar" />
<partial name="_AccountMenu" />
</aside>
<button type="button" class="sidebar-backdrop" id="sidebar-backdrop" aria-label="Đóng thanh điều hướng" hidden></button>
<div class="dashboard-main" id="dashboard-main">
<header class="dashboard-header">
<button type="button" id="sidebar-toggle" class="icon-button" aria-label="Thu gọn thanh điều hướng" aria-controls="app-sidebar" aria-expanded="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg></button>
<span class="page-title">@ViewData["Title"]</span>
</header>
<main id="main-content" class="app-content @(isPropertyPage ? "property-management" : "")" tabindex="-1">
@if (isPropertyPage) { <partial name="_PropertyNotifications" /> }
@RenderBody()
</main>
</div>
<partial name="_Toast" />
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/logout-confirm.js" asp-append-version="true"></script>
<script src="~/js/auth-interceptor.js" asp-append-version="true"></script>
<script src="~/js/password-toggle.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
@if (isPropertyPage) {
<partial name="_PropertyConfirm" />
<script src="~/js/property-management.js" asp-append-version="true"></script>
}
@if (User.Identity?.IsAuthenticated == true) {
<script src="~/js/session-status.js" asp-append-version="true"></script>
}
</body>
</html>
