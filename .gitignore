# Ignore local dev SQLite database
**/Data/local-dev.sqlite
**/Data/*.sqlite
**/*.sqlite-shm
**/*.sqlite-wal

# User files
*.user
*.suo
.vs/
.vscode/

# Build outputs
bin/
obj/

# Local SQLite backups created by the explicit permission initializer
*.sqlite.before-s1-04-*.bak*

# Environment files (keep .env.example but ignore .env)
.env
.env.local

# Tests output
**/TestResults/

